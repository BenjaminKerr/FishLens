<Page x:Class="FishLens_App.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings"
        Background="#F5F8FA">


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        
        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#0D3640" 
                Padding="30,20">
            <TextBlock Text="Settings" 
                       FontSize="28" 
                       FontWeight="SemiBold"
                       Foreground="White"/>
        </Border>

        <!-- Settings Content -->
        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Padding="30">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">

                <!-- Analysis Settings -->
                <TextBlock Text="Analysis" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="#0D3640"
                           Margin="0,0,0,15"/>

                <Border Background="White" 
                        BorderBrush="#E1E8ED" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>

                        <!-- Confidence Threshold -->
                        <TextBlock Text="Confidence Threshold for Data Entry" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#0D3640"
                                   Margin="0,0,0,8"/>
                        <TextBlock Text="Minimum confidence level required to automatically populate analysis fields" 
                                   FontSize="12" 
                                   Foreground="#8BA5AE"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="confidenceThreshold"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="75"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"
                                    ValueChanged="ConfidenceThreshold_ValueChanged"/>

                            <Border Grid.Column="1"
                                    Background="#0D3640"
                                    CornerRadius="4"
                                    Padding="12,6"
                                    MinWidth="60">
                                <TextBlock x:Name="confidenceValue" 
                                           Text="75%"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>

                    </StackPanel>
                </Border>
                <!-- Script Output Settings -->
                <TextBlock Text="Output" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="#0D3640"
                           Margin="0,0,0,15"/>
                <StackPanel>
                    <!-- Hide Errors -->
                    <CheckBox x:Name="hideOutput"
                                  Content="Redirect Output Messages"
                                  FontSize="14"
                                  Foreground="#0D3640"
                                  Margin="0,0,0,0"
                                  IsChecked="False"
                                  Click="ToggleOutputMessages"/>
                    <TextBlock Text="Show output messages as a pop-up window at the end of the program instead of in the terminal."
                           FontSize="12"
                               Margin="0,0,0,15"/>

                    <!-- Hide Output -->
                    <CheckBox x:Name="hideErrors"
                                  Content="Redirect Error Messages"
                                  FontSize="14"
                                  Foreground="#0D3640"
                                  Margin="0,0,0,0"
                                  IsChecked="False"
                                  Click="ToggleErrorMessages"/>
                    <TextBlock Text="Show error messages as a pop-up window at the end of the program instead of in the terminal."
                        FontSize="12"
                        Margin="0,0,0,15"/>
                                  
                    
                </StackPanel>
                <!-- Video Settings -->
                <TextBlock Text="Video" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="#0D3640"
                           Margin="0,0,0,15"/>

                <Border Background="White" 
                        BorderBrush="#E1E8ED" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>

                        <!-- Auto-play Videos -->
                        <CheckBox x:Name="autoPlayVideos"
                                  Content="Auto-play videos when selected"
                                  FontSize="14"
                                  Foreground="#0D3640"
                                  Margin="0,0,0,15"
                                  IsChecked="True"/>

                        <!-- Video Quality -->
                        <TextBlock Text="Video Playback Quality" 
                                   FontSize="14" 
                                   FontWeight="SemiBold"
                                   Foreground="#0D3640"
                                   Margin="0,0,0,8"/>
                        <ComboBox x:Name="videoQuality"
                                  FontSize="14"
                                  Padding="8"
                                  BorderBrush="#8BA5AE"
                                  BorderThickness="1">
                            <ComboBoxItem Content="High"/>
                            <ComboBoxItem Content="Medium" IsSelected="True"/>
                            <ComboBoxItem Content="Low"/>
                        </ComboBox>

                    </StackPanel>
                </Border>

                <!-- Accessibility Settings -->
                <TextBlock Text="Accessibility" 
                           FontSize="20" 
                           FontWeight="SemiBold"
                           Foreground="#0D3640"
                           Margin="0,0,0,15"/>

                <Border Background="White" 
                        BorderBrush="#E1E8ED" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>

                        <!-- High Contrast Mode -->
                        <CheckBox x:Name="highContrastMode"
                                  Content="High contrast mode"
                                  FontSize="14"
                                  Foreground="#0D3640"
                                  Margin="0,0,0,15"/>

                        <!-- Large Text -->
                        <CheckBox x:Name="largeText"
                                  Content="Use larger text throughout the application"
                                  FontSize="14"
                                  Foreground="#0D3640"
                                  Margin="0,0,0,15"/>

                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E1E8ED" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                
                <Button Content="Save Settings" 
                        Click="SaveSettings_Click"
                        Background="#0D3640"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="20,10"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#165666"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

    </Grid>
</Page>