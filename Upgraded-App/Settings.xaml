<Page x:Class="FishLens_App.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="{DynamicResource WindowBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackground}" 
                Padding="30,20">
            <TextBlock Text="Settings" 
                       FontSize="{DynamicResource LargeHeaderFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OnAccentForeground}"/>
        </Border>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Padding="30"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">

                <!-- Analysis-in-progress warning banner -->
                <Border x:Name="analysisWarningBanner"
                        Background="#FFF3E0"
                        BorderBrush="#FF9800"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="16,12"
                        Margin="0,0,0,20"
                        Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#x26A0;" FontSize="16" Foreground="#E65100" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="Analysis is currently running. Run, location, and settings changes are locked until the analysis completes or is cancelled."
                                   FontSize="13" Foreground="#E65100" TextWrapping="Wrap" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="Analysis" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Low-Confidence Highlight Threshold"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Detections below this percent stay populated, but they get the red low-confidence tint in the video library."
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="confidenceThreshold"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="75"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"
                                    SmallChange="1"
                                    LargeChange="5"
                                    ValueChanged="ConfidenceThreshold_ValueChanged"/>

                            <TextBox x:Name="confidenceValueBox"
                                     Grid.Column="1"
                                     Text="75"
                                     Width="56"
                                     Padding="8,4"
                                     FontSize="{DynamicResource BaseFontSize}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource PrimaryColorBrush}"
                                     Background="{DynamicResource PageBackgroundBrush}"
                                     BorderBrush="{DynamicResource BorderBrush}"
                                     HorizontalContentAlignment="Center"
                                     VerticalContentAlignment="Center"
                                     VerticalAlignment="Center"
                                     LostFocus="ConfidenceValueBox_LostFocus"
                                     KeyDown="ConfidenceValueBox_KeyDown"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ── Run Setup (admin only) ──────────────────────────────── -->
                <TextBlock x:Name="RunSetupText" Text="Run Setup"
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <Border x:Name="RunSetupCard"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Create and manage seasonal monitoring runs. Each run stores its own fish and no-fish records."
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,15"
                                   TextWrapping="Wrap"/>

                        <!-- Active run display -->
                        <TextBlock Text="Active Run"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,6"/>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="activeRunDropdown"
                                      Grid.Column="0"
                                      Height="36"
                                      Padding="8"
                                      FontSize="{DynamicResource BaseFontSize}"
                                      Margin="0,0,10,0"
                                      SelectionChanged="ActiveRunDropdown_SelectionChanged"/>

                            <Button x:Name="setActiveRunButton"
                                    Grid.Column="1"
                                    Content="Set Active"
                                    Height="36"
                                    Padding="14,0"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    Background="{DynamicResource HeaderBackground}"
                                    Foreground="{DynamicResource OnAccentForeground}"
                                    BorderThickness="0"
                                    Margin="0,0,8,0"
                                    Click="SetActiveRun_Click"/>

                            <Button x:Name="endRunButton"
                                    Grid.Column="2"
                                    Content="End Run"
                                    Height="36"
                                    Padding="14,0"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    Background="#C62828"
                                    Foreground="White"
                                    BorderThickness="0"
                                    Click="EndRun_Click"/>
                        </Grid>

                        <!-- Current run status -->
                        <TextBlock x:Name="runStatusText"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,15"
                                   TextWrapping="Wrap"/>

                        <!-- Create new run -->
                        <TextBlock Text="Create New Run"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="newRunNameBox"
                                     Grid.Column="0"
                                     Height="36"
                                     Padding="8"
                                     FontSize="{DynamicResource BaseFontSize}"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"
                                     ToolTip="e.g. Spring 2026"/>

                            <Button x:Name="createRunButton"
                                    Grid.Column="1"
                                    Content="Create Run"
                                    Height="36"
                                    Padding="14,0"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    Background="{DynamicResource HeaderBackground}"
                                    Foreground="{DynamicResource OnAccentForeground}"
                                    BorderThickness="0"
                                    Click="CreateRun_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ──────────────────────────────────────────────────────────── -->

                <!-- ── Locations (admin only) ───────────────────────────────── -->
                <TextBlock x:Name="LocationsText" Text="Locations"
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <Border x:Name="LocationsCard"
                        Background="{DynamicResource CardBackground}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Manage named monitoring locations and their upstream direction."
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,15"
                                   TextWrapping="Wrap"/>

                        <!-- List of existing locations -->
                        <StackPanel x:Name="locationsListPanel" Margin="0,0,0,15"/>

                        <!-- Add new location row -->
                        <TextBlock Text="Add New Location"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="newLocationName"
                                     Grid.Column="0"
                                     Height="36"
                                     Padding="8"
                                     FontSize="{DynamicResource BaseFontSize}"
                                     Margin="0,0,10,0"
                                     VerticalContentAlignment="Center"/>

                            <ComboBox x:Name="newLocationDirection"
                                      Grid.Column="1"
                                      Height="36"
                                      Margin="0,0,10,0"
                                      FontSize="{DynamicResource BaseFontSize}"
                                      SelectedIndex="0">
                                <ComboBoxItem Content="Upstream: Left"/>
                                <ComboBoxItem Content="Upstream: Right"/>
                            </ComboBox>

                            <Button x:Name="addLocationButton"
                                    Grid.Column="2"
                                    Content="Add Location"
                                    Height="36"
                                    Padding="14,0"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    Background="{DynamicResource HeaderBackground}"
                                    Foreground="{DynamicResource OnAccentForeground}"
                                    BorderThickness="0"
                                    Click="AddLocation_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
                <!-- ──────────────────────────────────────────────────────────── -->

                <TextBlock Text="Output" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <StackPanel>
                    <CheckBox x:Name="enableFastMode"
                              Content="Enable Fast Mode"
                              FontSize="{DynamicResource BaseFontSize}"
                              Foreground="{DynamicResource PrimaryText}"
                              Margin="0,0,0,0"
                              IsChecked="False"
                              Click="ToggleFastMode"/>

                    <TextBlock Text="Process every other frame and use a lower YOLO resolution. Speeds up analysis but may reduce accuracy."
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>

                    <CheckBox x:Name="forceReanalyze"
                              Content="Force Re-analyze Already Processed Videos"
                              FontSize="{DynamicResource BaseFontSize}"
                              Foreground="{DynamicResource PrimaryText}"
                              Margin="0,0,0,0"
                              IsChecked="False"
                              Click="SettingsControl_Changed"/>

                    <TextBlock Text="When enabled, videos that were previously analyzed will be processed again. Use this after fixing data or changing settings that affect accuracy."
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="Accessibility" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <CheckBox x:Name="highContrastMode"
                                  Content="High contrast mode"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Margin="0,0,0,15"
                                  Click="SettingsControl_Changed"/>

                        <CheckBox x:Name="largeText"
                                  Content="Use larger text throughout the application"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Margin="0,0,0,15"
                                  Click="SettingsControl_Changed"/>
                    </StackPanel>
                </Border>

                <TextBlock x:Name="CreateUserText" Text="Create User"
           FontSize="{DynamicResource LargeHeaderFontSize}"
           FontWeight="SemiBold"
           Foreground="{DynamicResource PrimaryText}"
           Margin="0,0,0,15"/>

                <Border x:Name="CreateUserCard" Background="{DynamicResource CardBackground}" 
        BorderBrush="{DynamicResource BorderBrush}" 
        BorderThickness="1" 
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,30">
                    <StackPanel>

                        <TextBlock Text="Add a new user account"
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryText}"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"/>

                        <TextBlock Text="Username"
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryText}"/>

                        <TextBox x:Name="NewUsername"
                 Height="36"
                 Padding="8"
                 FontSize="{DynamicResource BaseFontSize}"
                 Margin="0,5,0,15"/>
                        <TextBlock Text="Email"
           FontSize="{DynamicResource BaseFontSize}"
           Foreground="{DynamicResource SecondaryText}"/>

                        <TextBox x:Name="NewUserEmail"
         Height="36"
         Padding="8"
         FontSize="{DynamicResource BaseFontSize}"
         Margin="0,5,0,15"/>


                        <TextBlock Text="Password"
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryText}"/>

                        <PasswordBox x:Name="NewPassword"
                     Height="36"
                     Padding="8"
                     FontSize="{DynamicResource BaseFontSize}"
                     Margin="0,5,0,20"/>
                        <TextBlock Text="Role"  
           FontSize="{DynamicResource BaseFontSize}"
           Foreground="{DynamicResource SecondaryText}"/>

                        <ComboBox x:Name="RoleComboBox"
          Width="200"
          HorizontalAlignment="Left"
          Margin="0,5,0,0"
          DisplayMemberPath="Name"
          SelectedValuePath="Id"
          FontSize="{DynamicResource BaseFontSize}">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox">
                                    <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBox">
                                                <Grid>
                                                    <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="32"/>
                                                            </Grid.ColumnDefinitions>

                                                            <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"/>

                                                            <!-- Down arrow -->
                                                            <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="{DynamicResource SecondaryText}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                                                            <ToggleButton Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press">
                                                                <ToggleButton.Template>
                                                                    <ControlTemplate TargetType="ToggleButton">
                                                                        <Border Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </ToggleButton.Template>
                                                            </ToggleButton>
                                                        </Grid>
                                                    </Border>

                                                    <!-- Dropdown popup -->
                                                    <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                                        <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                <StackPanel IsItemsHost="True"/>
                                                            </ScrollViewer>
                                                        </Border>
                                                    </Popup>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HeaderBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsDropDownOpen" Value="True">
                                                        <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HeaderBackground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.Style>

                            <!-- Style each dropdown item -->
                            <ComboBox.ItemContainerStyle>
                                <Style TargetType="ComboBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                    <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ComboBoxItem">
                                                <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsHighlighted" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WindowBackground}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HeaderBackground}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ComboBox.ItemContainerStyle>
                        </ComboBox>


                        <Button Content="Create User"
                Width="140"
                Padding="10,6"
                Background="{DynamicResource HeaderBackground}"
                Foreground="{DynamicResource OnAccentForeground}"
                FontSize="{DynamicResource BaseFontSize}"
                FontWeight="SemiBold"
                BorderThickness="0"
                HorizontalAlignment="Left"
                Cursor="Hand"
                Click="CreateUserClick">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="6"
                                                        Margin= "0, 30 ,0, 0"
                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>
                </Border>
                <TextBlock x:Name="ManageUsersText" Text="Manage Users"
           FontSize="{DynamicResource LargeHeaderFontSize}"
           FontWeight="SemiBold"
           Foreground="{DynamicResource PrimaryText}"
           Margin="0,0,0,15"/>

                <Border x:Name="ManageUsersCard" Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="1"
        CornerRadius="8"
        Padding="20"
        Margin="0,0,0,30">

                    <StackPanel>

                        <TextBlock Text="Edit username or role for existing accounts, then click Save Changes."
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryText}"
                   Margin="0,0,0,15"
                   TextWrapping="Wrap"/>

                        <DataGrid x:Name="UsersGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="None"
                  RowHeaderWidth="0"
                  MinHeight="240"
                  Margin="0,0,0,15"
                  BorderThickness="0"
                  Background="Transparent"
                  RowBackground="Transparent"
                  AlternatingRowBackground="Transparent"
                  SelectionUnit="FullRow"
                  FontSize="{DynamicResource BaseFontSize}" SelectionChanged="UsersGrid_SelectionChanged">

                            <!-- Modern style overrides -->
                            <DataGrid.Resources>
                                <!-- Remove the default cell focus border -->
                                <Style TargetType="DataGridCell">
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Padding" Value="12,10"/>
                                    <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="VerticalContentAlignment" Value="Center"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="DataGridCell">
                                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>

                                <!-- Modern column headers -->
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
                                    <Setter Property="Padding" Value="12,8"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                </Style>

                                <!-- Modern row style with hover -->
                                <Style TargetType="DataGridRow">
                                    <Setter Property="Background" Value="Transparent"/>
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Setter Property="Margin" Value="0"/>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.Resources>

                            <DataGrid.Columns>

                                <!-- ID column completely hidden -->
                                <DataGridTextColumn Header="Id"
                        Binding="{Binding Id}"
                        IsReadOnly="True"
                        Visibility="Collapsed"/>

                                <!-- Username with styled editing -->
                                <DataGridTemplateColumn Header="Username" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Username}"
                           VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#888888"
                        BorderThickness="1"
                        CornerRadius="6"
                        Background="{DynamicResource CardBackground}">
                                                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                             BorderThickness="0"
                             Background="Transparent"
                             Foreground="{DynamicResource PrimaryText}"
                             FontSize="{DynamicResource BaseFontSize}"
                             Padding="10,8"
                             VerticalContentAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <!-- Email -->
                                <DataGridTemplateColumn Header="Email" Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Email}"
                       VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#888888"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource CardBackground}">
                                                <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{DynamicResource PrimaryText}"
                         FontSize="{DynamicResource BaseFontSize}"
                         Padding="10,8"
                         VerticalContentAlignment="Center"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                                <!-- Role with styled ComboBox -->
                                <DataGridTemplateColumn Header="Role" Width="220">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding role.Name}"
                           VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.Roles, RelativeSource={RelativeSource AncestorType=Page}}"
                          DisplayMemberPath="Name"

                          SelectedValue="{Binding role, UpdateSourceTrigger=PropertyChanged}"
                          FontSize="{DynamicResource BaseFontSize}">
                                                <ComboBox.Style>
                                                    <Style TargetType="ComboBox">
                                                        <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                        <Setter Property="BorderBrush" Value="#888888"/>
                                                        <Setter Property="BorderThickness" Value="1"/>
                                                        <Setter Property="Padding" Value="10,8"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ComboBox">
                                                                    <Grid>
                                                                        <Border x:Name="Border"
                                                    Background="{TemplateBinding Background}"
                                                    BorderBrush="{TemplateBinding BorderBrush}"
                                                    BorderThickness="{TemplateBinding BorderThickness}"
                                                    CornerRadius="6">
                                                                            <Grid>
                                                                                <Grid.ColumnDefinitions>
                                                                                    <ColumnDefinition Width="*"/>
                                                                                    <ColumnDefinition Width="32"/>
                                                                                </Grid.ColumnDefinitions>

                                                                                <ContentPresenter Grid.Column="0"
                                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Left"/>

                                                                                <Path Grid.Column="1"
                                                          Data="M0,0 L4,4 L8,0"
                                                          Stroke="{DynamicResource SecondaryText}"
                                                          StrokeThickness="1.5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                                                                <ToggleButton Grid.ColumnSpan="2"
                                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                                  Background="Transparent"
                                                                  BorderThickness="0"
                                                                  Focusable="False"
                                                                  ClickMode="Press">
                                                                                    <ToggleButton.Template>
                                                                                        <ControlTemplate TargetType="ToggleButton">
                                                                                            <Border Background="Transparent"/>
                                                                                        </ControlTemplate>
                                                                                    </ToggleButton.Template>
                                                                                </ToggleButton>
                                                                            </Grid>
                                                                        </Border>

                                                                        <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                                   Placement="Bottom"
                                                   AllowsTransparency="True"
                                                   Focusable="False"
                                                   PopupAnimation="Slide">
                                                                            <Border Background="{DynamicResource CardBackground}"
                                                        BorderBrush="#888888"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Margin="0,4,0,0"
                                                        Padding="4"
                                                        MinWidth="{TemplateBinding ActualWidth}"
                                                        MaxHeight="200">
                                                                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                                    <StackPanel IsItemsHost="True"/>
                                                                                </ScrollViewer>
                                                                            </Border>
                                                                        </Popup>
                                                                    </Grid>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HeaderBackground}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsDropDownOpen" Value="True">
                                                                            <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HeaderBackground}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ComboBox.Style>

                                                <ComboBox.ItemContainerStyle>
                                                    <Style TargetType="ComboBoxItem">
                                                        <Setter Property="Padding" Value="10,8"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                                        <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ComboBoxItem">
                                                                    <Border x:Name="ItemBorder"
                                                Background="Transparent"
                                                CornerRadius="4"
                                                Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter/>
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsHighlighted" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WindowBackground}"/>
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HeaderBackground}"/>
                                                                            <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ComboBox.ItemContainerStyle>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>

                            </DataGrid.Columns>



                        </DataGrid>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Refresh"
                    Width="120"
                    Padding="10,6"
                    Background="{DynamicResource HeaderBackground}"
                    Foreground="{DynamicResource OnAccentForeground}"
                    FontSize="{DynamicResource BaseFontSize}"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="RefreshUsers_Click"
                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Save Changes"
                    Width="150"
                    Padding="10,6"
                    Background="{DynamicResource HeaderBackground}"
                    Foreground="{DynamicResource OnAccentForeground}"
                    FontSize="{DynamicResource BaseFontSize}"
                    FontWeight="SemiBold"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="SaveUserChanges_Click">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="6"
                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>

                    </StackPanel>
                </Border>



            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackground}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <TextBlock x:Name="saveStatusText"
                           Visibility="Collapsed"
                           FontSize="{DynamicResource BaseFontSize}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="0,0,16,0"/>

                <Button x:Name="saveSettingsButton"
                        Content="Save Settings" 
                        Click="SaveSettings_Click"
                        Background="{DynamicResource HeaderBackground}"
                        Foreground="{DynamicResource OnAccentForeground}"
                        FontSize="{DynamicResource BaseFontSize}"
                        FontWeight="SemiBold"
                        Padding="20,10"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>
