<Page x:Class="FishLens_App.Settings"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Settings"
      Background="{DynamicResource WindowBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackground}" 
                Padding="30,20">
            <TextBlock Text="Settings" 
                       FontSize="{DynamicResource LargeHeaderFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OnAccentForeground}"/>
        </Border>

        <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Padding="30"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">

                <TextBlock Text="Analysis" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <TextBlock Text="Confidence Threshold for Data Entry" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <TextBlock Text="Minimum confidence level required to automatically populate analysis fields" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,10"
                                   TextWrapping="Wrap"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="confidenceThreshold"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="75"
                                    TickFrequency="5"
                                    IsSnapToTickEnabled="True"
                                    IsMoveToPointEnabled="True"
                                    VerticalAlignment="Center"
                                    Margin="0,0,15,0"
                                    ValueChanged="ConfidenceThreshold_ValueChanged"/>

                            <Border Grid.Column="1"
                                    Background="{DynamicResource HeaderBackground}"
                                    CornerRadius="4"
                                    Padding="12,6"
                                    MinWidth="60">
                                <TextBlock x:Name="confidenceValue" 
                                           Text="75%"
                                           FontSize="{DynamicResource BaseFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForeground}"
                                           HorizontalAlignment="Center"/>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Output" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <StackPanel>
                    <CheckBox x:Name="hideOutput"
                              Content="Redirect Output Messages"
                              FontSize="{DynamicResource BaseFontSize}"
                              Foreground="{DynamicResource PrimaryText}"
                              Margin="0,0,0,0"
                              IsChecked="False"
                              Click="ToggleOutputMessages"/>

                    <TextBlock Text="Show output messages as a pop-up window at the end of the program instead of in the terminal."
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>

                    <CheckBox x:Name="hideErrors"
                              Content="Redirect Error Messages"
                              FontSize="{DynamicResource BaseFontSize}"
                              Foreground="{DynamicResource PrimaryText}"
                              Margin="0,0,0,0"
                              IsChecked="False"
                              Click="ToggleErrorMessages"/>

                    <TextBlock Text="Show error messages as a pop-up window at the end of the program instead of in the terminal."
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"
                               Margin="0,0,0,15"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <TextBlock Text="Accessibility" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Margin="0,0,0,15"/>

                <Border Background="{DynamicResource CardBackground}" 
                        BorderBrush="{DynamicResource BorderBrush}" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Padding="20"
                        Margin="0,0,0,30">
                    <StackPanel>
                        <CheckBox x:Name="highContrastMode"
                                  Content="High contrast mode"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Margin="0,0,0,15"/>

                        <CheckBox x:Name="largeText"
                                  Content="Use larger text throughout the application"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Foreground="{DynamicResource PrimaryText}"
                                  Margin="0,0,0,15"/>
                    </StackPanel>
                </Border>
           



            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackground}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">

                        <Button Content="Save Settings" 
                        Click="SaveSettings_Click"
                        Background="{DynamicResource HeaderBackground}"
                        Foreground="{DynamicResource OnAccentForeground}"
                        FontSize="{DynamicResource BaseFontSize}"
                        FontWeight="SemiBold"
                        Padding="20,10"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>