<Window x:Class="FishLens_App.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Processing" 
        Height="190" 
        Width="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock x:Name="messageText" 
                       Text="Processing videos, please wait..." 
                       FontSize="{DynamicResource BaseFontSize}"
                       Margin="0,0,0,6"
                       TextWrapping="Wrap"/>
            <TextBlock x:Name="frameText"
                       Text=""
                       FontSize="{DynamicResource BaseFontSize}"
                       Foreground="Gray"
                       Margin="0,0,0,14"
                       TextWrapping="Wrap"/>
            <ProgressBar x:Name="progressBar" 
                         Height="20" 
                         IsIndeterminate="True"
                         Visibility="Visible"/>
            <Border x:Name="frameSegmentContainer"
                    Visibility="Collapsed"
                    Height="20"
                    Background="Transparent">
                <UniformGrid x:Name="frameSegments" Rows="1"/>
            </Border>
        </StackPanel>
    </Grid>
</Window>