<Window x:Class="FishLens_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FishLens_App"
        mc:Ignorable="d"
        Title="FishLens" Height="{x:Static SystemParameters.PrimaryScreenHeight}" Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackground}">


    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name ="SidebarColumn" Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Frame x:Name="MainFrame" NavigationUIVisibility="Visible" Grid.Column="1" Panel.ZIndex="1"/>
        <!--Sidebar: Media Selector-->
        <Border x:Name="SideBar" Width="320" Grid.Column="0" Background="{DynamicResource AccentBrush}" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource HeaderBackground}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Sidebar Header -->
                <StackPanel Grid.Row="0" Margin="20,30,20,20">
                    <Grid x:Name="ButtonGrid" Margin="0" ShowGridLines="False">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button x:Name="Home" 
                Background="{x:Null}" 
                Foreground="{DynamicResource OnAccentForeground}" 
Grid.Column="0" 
BorderBrush="Transparent" 
Click="HomeButtonClick"
Padding="10"
Width="70"
Height="70">
                            <Viewbox Width="40" Height="40">
                                <TextBlock Text="🏠" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="History" 
                Background="{x:Null}" 
                Foreground="{DynamicResource OnAccentForeground}" 
Grid.Column="1" 
BorderBrush="Transparent" 
Click="HistoryButtonClick"
Padding="10"
Width="70"
Height="70">
                            <Viewbox Width="40" Height="40">
                                <TextBlock Text="📜" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="Settings" 
                Background="{x:Null}" 
                Foreground="{DynamicResource OnAccentForeground}" 
Grid.Column="2" 
BorderBrush="Transparent" 
Click="SettingsButtonClick"
Padding="10"
Width="70"
Height="70">
                            <Viewbox Width="40" Height="40">
                                <TextBlock Text="⚙️" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>
                    </Grid>
                    <Rectangle x:Name="sidebarSeperator" Height="2" Fill="{DynamicResource HoverBackgroundBrush}" Margin="0,10,0,10"/>
                    <TextBlock Text="Video Library" 
                               x:Name="videoLibraryTitle"
                       FontSize="{DynamicResource HeaderFontSize}"
                       FontWeight="SemiBold" 
                       Foreground="{DynamicResource OnAccentForeground}"
                       HorizontalAlignment="Center"/>
                </StackPanel>

                <!-- Video List -->
                <ScrollViewer Grid.Row="1" 
                      VerticalScrollBarVisibility="Auto"
                      Margin="10,0,10,20">
                    <StackPanel x:Name="videoList" Margin="10,0"/>
                </ScrollViewer>

                <!-- Delete + Undo Buttons -->
                <StackPanel Grid.Row="2" Orientation="Vertical" Margin="20,0,20,20">
                    <Button x:Name="deleteSelectedVideos"
                            Click="DeleteSelectedVideosClick"
                            Background="{DynamicResource HeaderBackground}"
                            Foreground="{DynamicResource OnAccentForeground}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="SemiBold"
                            Padding="12"
                            Margin="0,0,0,8"
                            BorderThickness="0"
                            Cursor="Hand">
                        Delete Selected Videos
                    </Button>

                    <Button x:Name="undoLastDelete"
                            Click="UndoLastDeleteClick"
                            Background="{DynamicResource CardBackground}"
                            Foreground="{DynamicResource PrimaryText}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="SemiBold"
                            Padding="12"
                            BorderThickness="0"
                            Cursor="Hand">
                        Undo Last Delete
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--Main Content: File Upload + Media Viewer-->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Grid Grid.Row="0" Margin="40,30,40,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Name="Title" 
                               FontSize="{DynamicResource TitleFontSize}"
                               FontFamily="Georgia" 
                               FontWeight="Bold"
                               Foreground="{DynamicResource PrimaryText}">
                        FishLens
                    </TextBlock>
                </StackPanel>

                <!-- Export Button (initially hidden) -->
                <Button Name="exportData" 
                        Grid.Column="1"
                        Click="ExportDataClick" 
                        VerticalAlignment="Center"
                        Padding="20,12" 
                        Background="{DynamicResource AccentBrush}" 
                        Foreground="{DynamicResource OnAccentForeground}"
                        FontSize="{DynamicResource BaseFontSize}"
                        FontWeight="Medium"
                        BorderThickness="0"
                        Cursor="Hand"
                        Margin="0,0,15,0"
                        Visibility="Collapsed">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                    </Button.Effect>
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                    📊 Export Data to Excel
                </Button>

                <Button Name="openFolder"
                    Grid.Column="2"
                    Click="OpenFolderClick" 
                    VerticalAlignment="Center"
                    Padding="20,12" 
                    Background="{DynamicResource AccentBrush}" 
                    Foreground="{DynamicResource OnAccentForeground}"
                    FontSize="{DynamicResource BaseFontSize}"
                    FontWeight="Medium"
                    BorderThickness="0"
                    Cursor="Hand">
                    <Button.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.3"/>
                    </Button.Effect>
                    <Button.Resources>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" 
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Resources>
                    📁 Choose Video Folder
                </Button>
                <Button Name="SignOutButton"
        Grid.Column="3"
        Click="SignOutButtonClick"
        VerticalAlignment="Center"
        Padding="30,12"
        Margin="20,0,0,0"
        Background="{DynamicResource HeaderBackground}"
        Foreground="{DynamicResource OnAccentForeground}"
        FontSize="{DynamicResource BaseFontSize}"
        FontWeight="SemiBold"
        BorderThickness="0"
        Cursor="Hand">

                    <Button.Effect>
                        <DropShadowEffect BlurRadius="10"
                          ShadowDepth="2"
                          Opacity="0.35"/>
                    </Button.Effect>

                     Sign Out
                </Button>
            </Grid>

            <!-- Video Player and Analysis Panel Side by Side -->
            <Grid Grid.Row="1" Margin="40,0,40,40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- Video Player Section -->
                <Border Grid.Column="0" 
                        Margin="0,0,10,0" 
                        Background="{DynamicResource CardBackground}" 
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                    </Border.Effect>

                    <Grid>
                        <!-- Placeholder when no video selected -->
                        <StackPanel x:Name="placeholderPanel"
                                    HorizontalAlignment="Center" 
                                    VerticalAlignment="Center">
                            <TextBlock Text="🎬" 
                                       FontSize="{DynamicResource LargeTitleFontSize}"
                                       HorizontalAlignment="Center"
                                       Opacity="0.3"/>
                            <TextBlock Text="Select a video from the library" 
                                       FontSize="{DynamicResource LargeFontSize}"
                                       Foreground="{DynamicResource SecondaryText}"
                                       HorizontalAlignment="Center"
                                       Margin="0,20,0,0"/>
                        </StackPanel>

                        <!-- Video Player -->
                        <MediaElement Name="videoPlayer" 
                                      LoadedBehavior="Manual"
                                      Stretch="Uniform"
                                      Margin="20"/>
                    </Grid>
                </Border>

                <!-- Data Display Section -->
                <Border Grid.Column="1" 
                        Margin="10,0,0,0" 
                        Background="{DynamicResource CardBackground}" 
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                    </Border.Effect>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="dataPanel" Margin="30">
                            <TextBlock Text="Analysis" 
                                       FontSize="{DynamicResource HeaderFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Margin="0,0,0,8"/>

                            <!-- Video Info - Small and Gray -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock x:Name="videoName" 
                                           Text="--" 
                                           FontSize="{DynamicResource BaseFontSize}"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,0,0,5"
                                           TextWrapping="Wrap"/>
                                <TextBlock x:Name="videoDateTime" 
                                           Text="--" 
                                           FontSize="{DynamicResource BaseFontSize}"
                                           Foreground="{DynamicResource SecondaryText}"/>
                            </StackPanel>

                            <!-- Fish Present -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Fish Present" 
                                           FontSize="{DynamicResource LargeFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="Status: " 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="fishPresentStatus" 
                                              FontSize="{DynamicResource BaseFontSize}"
                                              FontWeight="Medium"
                                              Foreground="{DynamicResource PrimaryText}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              BorderThickness="1"
                                              Padding="8,4"
                                              MinWidth="120">
                                        <ComboBoxItem Content="Present"/>
                                        <ComboBoxItem Content="Not Present"/>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Confidence: " 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock x:Name="fishPresentConfidence" 
                                               Text="--" 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Direction of Travel -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Direction of Travel" 
                                           FontSize="{DynamicResource LargeFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Margin="0,0,0,8"/>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Direction: " 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"
                                               Margin="0,0,8,0"/>
                                    <ComboBox x:Name="travelDirection" 
                                              FontSize="{DynamicResource BaseFontSize}"
                                              FontWeight="Medium"
                                              Foreground="{DynamicResource PrimaryText}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              BorderThickness="1"
                                              Padding="8,4"
                                              MinWidth="120">
                                        <ComboBoxItem Content="Upstream"/>
                                        <ComboBoxItem Content="Downstream"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>

                            <!-- Fish Species -->
                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Fish Species" 
                                           FontSize="{DynamicResource LargeFontSize}"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Margin="0,0,0,8"/>
                                <StackPanel Margin="0,0,0,8">
                                    <TextBlock Text="Species: " 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               Foreground="{DynamicResource SecondaryText}"
                                               Margin="0,0,0,4"/>
                                    <ComboBox x:Name="fishSpecies" 
                                              IsEditable="True"
                                              FontSize="{DynamicResource BaseFontSize}"
                                              FontWeight="Medium"
                                              Foreground="{DynamicResource PrimaryText}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              BorderThickness="1"
                                              Padding="8,4">
                                        <System:String xmlns:System="clr-namespace:System;assembly=netstandard">Chinook</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=netstandard">Omykiss</System:String>
                                    </ComboBox>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Confidence: " 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               Foreground="{DynamicResource SecondaryText}"/>
                                    <TextBlock x:Name="fishSpeciesConfidence" 
                                               Text="--" 
                                               FontSize="{DynamicResource BaseFontSize}"
                                               FontWeight="Medium"
                                               Foreground="{DynamicResource PrimaryText}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Save Button -->
                            <Button x:Name="saveButton" 
                                    Content="Save Changes" 
                                    Click="SaveButtonClick"
                                    Background="{DynamicResource HeaderBackground}"
                                    Foreground="{DynamicResource OnAccentForeground}"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,20">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
