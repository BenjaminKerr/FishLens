<Window x:Class="FishLens_App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FishLens_App"
        mc:Ignorable="d"
        Title="FishLens"
        Height="{x:Static SystemParameters.PrimaryScreenHeight}"
        Width="{x:Static SystemParameters.PrimaryScreenWidth}"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackground}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Frame x:Name="MainFrame"
               NavigationUIVisibility="Hidden"
               Grid.Column="1"
               Panel.ZIndex="1"
               Navigated="MainFrame_Navigated"/>

        <!-- ═══════════════════════════════════════════════════
             SIDEBAR
        ════════════════════════════════════════════════════ -->
        <Border x:Name="SideBar"
        Grid.Column="0"
        CacheMode="BitmapCache"
        Background="{DynamicResource AccentBrush}"
        BorderThickness="0,0,1,0"
        BorderBrush="{DynamicResource SidebarBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Nav buttons -->
                <StackPanel Grid.Row="0" Margin="16,24,16,16">
                    <Grid x:Name="ButtonGrid" Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="Home"
                                Grid.Column="0"
                                Background="Transparent"
                                Foreground="{DynamicResource OnAccentForeground}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="HomeButtonClick"
                                Padding="8"
                                Width="60" Height="60"
                                Cursor="Hand"
                                ToolTip="Home">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBd" Property="Background" Value="{DynamicResource SidebarBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="26" Height="26">
                                <TextBlock Text="&#x1F3E0;" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="History"
                                Grid.Column="1"
                                Background="Transparent"
                                Foreground="{DynamicResource OnAccentForeground}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="HistoryButtonClick"
                                Padding="8"
                                Width="60" Height="60"
                                Cursor="Hand"
                                ToolTip="Reports">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBd" Property="Background" Value="{DynamicResource SidebarBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="26" Height="26">
                                <TextBlock Text="&#x1F4DC;" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="Settings"
                                Grid.Column="2"
                                Background="Transparent"
                                Foreground="{DynamicResource OnAccentForeground}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="SettingsButtonClick"
                                Padding="8"
                                Width="60" Height="60"
                                Cursor="Hand"
                                ToolTip="Settings">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBd" Property="Background" Value="{DynamicResource SidebarBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="26" Height="26">
                                <TextBlock Text="&#x2699;&#xFE0F;" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>

                        <Button x:Name="AccountSettingsButton"
                                Grid.Column="3"
                                Background="Transparent"
                                Foreground="{DynamicResource OnAccentForeground}"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                Click="AccountSettingsButtonClick"
                                Visibility="Collapsed"
                                Padding="8"
                                Width="60" Height="60"
                                Cursor="Hand"
                                ToolTip="Account Settings">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="navBd"
                                            Background="{TemplateBinding Background}"
                                            CornerRadius="10"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="navBd" Property="Background" Value="{DynamicResource SidebarBorder}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <Viewbox Width="26" Height="26">
                                <TextBlock Text="&#x1F464;" Foreground="{DynamicResource OnAccentForeground}"/>
                            </Viewbox>
                        </Button>
                    </Grid>

                    <!-- Divider -->
                    <Rectangle x:Name="sidebarSeperator"
                               Height="1"
                               Fill="{DynamicResource SidebarBorder}"
                               Margin="0,16,0,14"
                               Opacity="0.6"/>

                    <TextBlock x:Name="videoLibraryTitle"
                               Text="VIDEO LIBRARY"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource OnAccentForeground}"
                               Opacity="0.55"
                               HorizontalAlignment="Left"
                               Margin="4,0,0,0"/>
                </StackPanel>

                <!-- Analysis progress -->
                <Border x:Name="analysisProgressArea"
                        Grid.Row="1"
                        Visibility="Collapsed"
                        Background="{DynamicResource SidebarBorder}"
                        CornerRadius="8"
                        Margin="12,0,12,10"
                        Padding="12,10">
                    <StackPanel>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="analysisStatusText"
                                       Grid.Column="0"
                                       Text="Analyzing..."
                                       Foreground="{DynamicResource OnAccentForeground}"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center"/>
                            <Button x:Name="inlineCancelButton"
                                    Grid.Column="1"
                                    Content="&#x2715; Cancel"
                                    Click="InlineCancelClick"
                                    Background="Transparent"
                                    Foreground="{DynamicResource OnAccentForeground}"
                                    BorderThickness="0"
                                    FontSize="11"
                                    Padding="6,2"
                                    Cursor="Hand"
                                    Margin="8,0,0,0"
                                    Opacity="0.75"/>
                        </Grid>
                        <TextBlock x:Name="analysisFrameText"
                                   Text=""
                                   Foreground="{DynamicResource OnAccentForeground}"
                                   FontSize="11"
                                   Opacity="0.6"
                                   Margin="0,0,0,8"
                                   TextTrimming="CharacterEllipsis"/>
                        <ProgressBar x:Name="analysisProgressBar"
                                     Height="4"
                                     Minimum="0"
                                     Maximum="100"
                                     Value="0"
                                     Background="{DynamicResource AccentBrush}"
                                     Foreground="{DynamicResource HoverBackgroundBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Video list -->
                <ScrollViewer Grid.Row="2"
                              VerticalScrollBarVisibility="Auto"
                              Margin="8,0,8,8">
                    <StackPanel x:Name="videoList" Margin="4,0"/>
                </ScrollViewer>

                <!-- Action buttons -->
                <StackPanel Grid.Row="3" Margin="12,0,12,20" Orientation="Vertical">
                    <Button x:Name="deleteSelectedVideos"
                            Style="{StaticResource AccentActionButton}"
                            Click="DeleteSelectedVideosClick"
                            IsEnabled="False"
                            Margin="0,0,0,6">
                        Delete Selected Videos
                    </Button>
                    <Button x:Name="changeLocationForSelected"
                            Style="{StaticResource NeutralActionButton}"
                            Click="ChangeLocationForSelectedClick"
                            IsEnabled="False"
                            Margin="0,0,0,6">
                        Change Location for Selected
                    </Button>
                    <Button x:Name="undoLastDelete"
                            Style="{StaticResource NeutralActionButton}"
                            Click="UndoLastDeleteClick"
                            IsEnabled="False">
                        Undo Last Delete
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ═══════════════════════════════════════════════════
             MAIN CONTENT
        ════════════════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header bar -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1">
                <Grid Margin="32,0,32,0" Height="68">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- App title -->
                    <TextBlock Grid.Column="0"
                               Name="Title"
                               Text="FishLens"
                               FontSize="22"
                               FontFamily="Georgia"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,32,0"/>

                    <!-- Spacer -->
                    <StackPanel Grid.Column="1"/>

                    <!-- Location selector -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <TextBlock Text="Location"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Opacity="0.8"/>
                        <ComboBox x:Name="locationDropdown"
                                  Width="150"
                                  VerticalContentAlignment="Center"
                                  SelectionChanged="LocationDropdown_SelectionChanged"/>
                    </StackPanel>

                    <!-- Run indicator -->
                    <StackPanel Grid.Column="3"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,20,0">
                        <TextBlock Text="Run"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SecondaryText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"
                                   Opacity="0.8"/>
                        <TextBlock x:Name="runDisplayLabel"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource PrimaryText}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="No run selected"/>
                    </StackPanel>

                    <!-- Export button -->
                    <Button Name="exportData"
                            Grid.Column="4"
                            Click="ExportDataClick"
                            VerticalAlignment="Center"
                            Padding="16,8"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentForeground}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="Medium"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0"
                            Visibility="Collapsed">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        &#x1F4CA; Export Data
                    </Button>

                    <!-- Choose folder button -->
                    <Button Name="openFolder"
                            Grid.Column="5"
                            Click="OpenFolderClick"
                            VerticalAlignment="Center"
                            Padding="16,8"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="{DynamicResource OnAccentForeground}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="Medium"
                            BorderThickness="0"
                            Cursor="Hand"
                            Margin="0,0,10,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        &#x1F4C1; Choose Folder
                    </Button>

                    <!-- Sign out button -->
                    <Button Name="SignOutButton"
                            Grid.Column="6"
                            Click="SignOutButtonClick"
                            VerticalAlignment="Center"
                            Padding="16,8"
                            Background="Transparent"
                            Foreground="{DynamicResource SecondaryText}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="Medium"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="8"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="{DynamicResource BorderBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                        Sign Out
                    </Button>
                </Grid>
            </Border>

            <!-- Content area: video player + analysis panel -->
            <Grid Grid.Row="1" Margin="24,20,24,24">
                <Grid.ColumnDefinitions>
                    <!-- Video player gets more room; analysis panel is wider than before -->
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="22"/>
                    <ColumnDefinition Width="1*" MinWidth="300"/>
                </Grid.ColumnDefinitions>

                <!-- ══ VIDEO PLAYER CARD ══ -->
                <Border Grid.Column="0"
                        Background="{DynamicResource CardBackground}"
                        CornerRadius="12"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#000000"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="2*"/>
                        </Grid.RowDefinitions>

                        <!-- Playback controls (Row 2) -->
                        <StackPanel Grid.Row="2"
                                    x:Name="videoControls"
                                    Margin="20,0,20,16"
                                    Visibility="Collapsed">

                            <!-- Scrubber row -->
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="videoCurrentTimeText"
                                           Grid.Column="0"
                                           Text="0:00"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,10,0"/>

                                <Grid Grid.Column="1">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Canvas x:Name="fishEmojiCanvas"
                                            Grid.Row="0"
                                            Height="16"
                                            IsHitTestVisible="False"
                                            HorizontalAlignment="Stretch"/>
                                    <Slider x:Name="videoScrubber"
                                            Grid.Row="1"
                                            Minimum="0" Maximum="1" Value="0"
                                            SmallChange="0.01" LargeChange="0.05"
                                            VerticalAlignment="Center"
                                            ValueChanged="VideoScrubber_ValueChanged"
                                            PreviewMouseDown="VideoScrubber_PreviewMouseDown"
                                            PreviewMouseMove="VideoScrubber_PreviewMouseMove"
                                            PreviewMouseUp="VideoScrubber_PreviewMouseUp">
                                        <Slider.Template>
                                            <ControlTemplate TargetType="Slider">
                                                <Grid>
                                                    <Border Height="4" CornerRadius="2"
                                                            Background="{DynamicResource BorderBrush}"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"/>
                                                    <Canvas Name="fishMarkersCanvas"
                                                            IsHitTestVisible="False"
                                                            HorizontalAlignment="Stretch"
                                                            VerticalAlignment="Center"
                                                            Height="4"/>
                                                    <Track Name="PART_Track" VerticalAlignment="Center">
                                                        <Track.DecreaseRepeatButton>
                                                            <RepeatButton Focusable="False">
                                                                <RepeatButton.Template>
                                                                    <ControlTemplate TargetType="RepeatButton">
                                                                        <Border Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </RepeatButton.Template>
                                                            </RepeatButton>
                                                        </Track.DecreaseRepeatButton>
                                                        <Track.IncreaseRepeatButton>
                                                            <RepeatButton Focusable="False">
                                                                <RepeatButton.Template>
                                                                    <ControlTemplate TargetType="RepeatButton">
                                                                        <Border Background="Transparent"/>
                                                                    </ControlTemplate>
                                                                </RepeatButton.Template>
                                                            </RepeatButton>
                                                        </Track.IncreaseRepeatButton>
                                                        <Track.Thumb>
                                                            <Thumb>
                                                                <Thumb.Template>
                                                                    <ControlTemplate TargetType="Thumb">
                                                                        <Ellipse Width="14" Height="14"
                                                                                 Fill="{DynamicResource AccentBrush}"
                                                                                 Stroke="White"
                                                                                 StrokeThickness="2">
                                                                            <Ellipse.Effect>
                                                                                <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.35"/>
                                                                            </Ellipse.Effect>
                                                                        </Ellipse>
                                                                    </ControlTemplate>
                                                                </Thumb.Template>
                                                            </Thumb>
                                                        </Track.Thumb>
                                                    </Track>
                                                </Grid>
                                            </ControlTemplate>
                                        </Slider.Template>
                                    </Slider>
                                </Grid>

                                <TextBlock x:Name="videoTotalTimeText"
                                           Grid.Column="2"
                                           Text="0:00"
                                           FontSize="12"
                                           Foreground="{DynamicResource SecondaryText}"
                                           VerticalAlignment="Center"
                                           Margin="10,0,0,0"/>
                            </Grid>

                            <!-- Transport buttons -->
                            <StackPanel Orientation="Horizontal"
                                        HorizontalAlignment="Center"
                                        Margin="0,4,0,0">

                                <Button x:Name="prevFishButton"
                                        Content="&#x1F41F;&#x25C0;"
                                        FontSize="11"
                                        Width="34" Height="34"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForeground}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,0,6,0"
                                        Visibility="Collapsed"
                                        Click="PrevFishButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17" Width="34" Height="34">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="skipBackButton"
                                        Content="&#x23EA;"
                                        FontSize="13"
                                        Width="34" Height="34"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForeground}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="0,0,8,0"
                                        Click="SkipBackButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17" Width="34" Height="34">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="playPauseButton"
                                        Content="&#x25B6;"
                                        FontSize="15"
                                        Width="42" Height="42"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForeground}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Click="PlayPauseButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="21" Width="42" Height="42">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="skipForwardButton"
                                        Content="&#x23E9;"
                                        FontSize="13"
                                        Width="34" Height="34"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForeground}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="8,0,0,0"
                                        Click="SkipForwardButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17" Width="34" Height="34">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button x:Name="nextFishButton"
                                        Content="&#x25B6;&#x1F41F;"
                                        FontSize="11"
                                        Width="34" Height="34"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForeground}"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        Margin="6,0,0,0"
                                        Visibility="Collapsed"
                                        Click="NextFishButton_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="17" Width="34" Height="34">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <!-- Video area (Row 1) -->
                        <Grid Grid.Row="1" MinHeight="200" MaxHeight="520">
                            <StackPanel x:Name="placeholderPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                <TextBlock Text="&#x1F3AC;"
                                           FontSize="72"
                                           HorizontalAlignment="Center"
                                           Opacity="0.18"/>
                                <TextBlock Text="Select a video from the library"
                                           FontSize="15"
                                           Foreground="{DynamicResource SecondaryText}"
                                           HorizontalAlignment="Center"
                                           Opacity="0.7"
                                           Margin="0,16,0,0"/>
                            </StackPanel>
                            <MediaElement Name="videoPlayer"
                                          LoadedBehavior="Manual"
                                          Stretch="Uniform"
                                          Margin="20,20,20,8"
                                          MediaOpened="VideoPlayer_MediaOpened"
                                          MediaEnded="VideoPlayer_MediaEnded"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Gutter spacer -->
                <StackPanel Grid.Column="1"/>

                <!-- ══ ANALYSIS PANEL ══ -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="12"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Per-video analysis card -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBackground}"
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource BorderBrush}">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.08" Color="#000000"/>
                        </Border.Effect>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="dataPanel" Margin="24,24,24,20">

                                <!-- Panel title -->
                                <TextBlock Text="Analysis"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryText}"
                                           Margin="0,0,0,20"/>

                                <!-- Track navigator -->
                                <Border x:Name="trackNavigator"
                                        Visibility="Collapsed"
                                        Background="{DynamicResource WindowBackground}"
                                        CornerRadius="8"
                                        Padding="10,8"
                                        Margin="0,0,0,16">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="trackPrevButton"
                                                Grid.Column="0"
                                                Content="&#x25C0;"
                                                Click="TrackPrevClick"
                                                FontSize="12"
                                                Padding="8,4"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock x:Name="trackLabel"
                                                       Text="Fish 1 / 1"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource PrimaryText}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock x:Name="trackVideoLabel"
                                                       Text=""
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SecondaryText}"
                                                       HorizontalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxWidth="160"/>
                                        </StackPanel>
                                        <Button x:Name="trackNextButton"
                                                Grid.Column="2"
                                                Content="&#x25B6;"
                                                Click="TrackNextClick"
                                                FontSize="12"
                                                Padding="8,4"
                                                BorderThickness="0"
                                                Cursor="Hand"
                                                Background="Transparent"
                                                Foreground="{DynamicResource AccentBrush}"/>
                                    </Grid>
                                </Border>

                                <!-- Video metadata -->
                                <Border Background="{DynamicResource WindowBackground}"
                                        CornerRadius="8"
                                        Padding="12,10"
                                        Margin="0,0,0,20">
                                    <StackPanel>
                                        <TextBlock x:Name="videoName"
                                                   Text="--"
                                                   FontSize="12"
                                                   FontWeight="Medium"
                                                   Foreground="{DynamicResource PrimaryText}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock x:Name="videoLocation"
                                                   Text="--"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   Margin="0,4,0,0"/>
                                        <TextBlock x:Name="videoDateTime"
                                                   Text="--"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryText}"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <!-- Divider -->
                                <Rectangle Height="1"
                                           Fill="{DynamicResource BorderBrush}"
                                           Margin="0,0,0,20"
                                           Opacity="0.6"/>

                                <!-- Fish Present -->
                                <TextBlock Text="Fish Present"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,0,0,10"
                                           Opacity="0.8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Status"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="fishPresentStatus"
                                              Grid.Column="1"
                                              IsEnabled="False">
                                        <ComboBoxItem Content="Present"/>
                                        <ComboBoxItem Content="Not Present"/>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Confidence"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="fishPresentConfidence"
                                             Grid.Column="1"
                                             Text="--"
                                             IsEnabled="False"/>
                                </Grid>

                                <!-- Divider -->
                                <Rectangle Height="1"
                                           Fill="{DynamicResource BorderBrush}"
                                           Margin="0,0,0,20"
                                           Opacity="0.6"/>

                                <!-- Direction of Travel — FIXED: ComboBox is sibling of TextBlock, not child -->
                                <TextBlock Text="Direction of Travel"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,0,0,10"
                                           Opacity="0.8"/>

                                <Grid Margin="0,0,0,20">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Direction"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="fishTravelDirection"
                                              Grid.Column="1"
                                              IsEnabled="False">
                                        <ComboBoxItem Content="Upstream"/>
                                        <ComboBoxItem Content="Downstream"/>
                                        <ComboBoxItem Content="Indecisive"/>
                                    </ComboBox>
                                </Grid>

                                <!-- Divider -->
                                <Rectangle Height="1"
                                           Fill="{DynamicResource BorderBrush}"
                                           Margin="0,0,0,20"
                                           Opacity="0.6"/>

                                <!-- Fish Species -->
                                <TextBlock Text="Fish Species"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryText}"
                                           Margin="0,0,0,10"
                                           Opacity="0.8"/>

                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Species"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox x:Name="fishSpecies"
                                              Grid.Column="1"
                                              IsEnabled="False">
                                        <System:String xmlns:System="clr-namespace:System;assembly=netstandard">Chinook</System:String>
                                        <System:String xmlns:System="clr-namespace:System;assembly=netstandard">Omykiss</System:String>
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,0,0,24">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="Confidence"
                                               FontSize="12"
                                               Foreground="{DynamicResource SecondaryText}"
                                               VerticalAlignment="Center"/>
                                    <TextBox x:Name="fishSpeciesConfidence"
                                             Grid.Column="1"
                                             Text="--"
                                             IsEnabled="False"/>
                                </Grid>

                                <!-- Save button — uses AccentBrush for visibility in both themes -->
                                <Button x:Name="saveButton"
                                        Content="Save Changes"
                                        Click="SaveButtonClick"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="{DynamicResource OnAccentForeground}"
                                        FontSize="{DynamicResource BaseFontSize}"
                                        FontWeight="SemiBold"
                                        Padding="0,12"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        HorizontalAlignment="Stretch"
                                        IsEnabled="False">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="bd"
                                                    Background="{TemplateBinding Background}"
                                                    CornerRadius="8"
                                                    Padding="{TemplateBinding Padding}"
                                                    Opacity="{TemplateBinding Opacity}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="bd" Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="bd" Property="Opacity" Value="0.45"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- Session overview card -->
                    <Border Grid.Row="2"
                            Background="{DynamicResource AccentBrush}"
                            CornerRadius="12"
                            BorderThickness="0">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="3" Opacity="0.12" Color="#000000"/>
                        </Border.Effect>
                        <StackPanel Margin="20,16">
                            <TextBlock Text="SESSION OVERVIEW"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource OnAccentForeground}"
                                       Opacity="0.6"
                                       Margin="0,0,0,12"/>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Run"
                                           FontSize="12"
                                           Foreground="{DynamicResource OnAccentForeground}"
                                           Opacity="0.65"
                                           Width="72"/>
                                <TextBlock x:Name="sessionRunText"
                                           Grid.Column="1"
                                           Text="--"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForeground}"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Location"
                                           FontSize="12"
                                           Foreground="{DynamicResource OnAccentForeground}"
                                           Opacity="0.65"
                                           Width="72"/>
                                <TextBlock x:Name="sessionLocationText"
                                           Grid.Column="1"
                                           Text="--"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForeground}"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Net ↑"
                                           FontSize="12"
                                           Foreground="{DynamicResource OnAccentForeground}"
                                           Opacity="0.65"
                                           Width="72"/>
                                <TextBlock x:Name="sessionNetUpstreamText"
                                           Grid.Column="1"
                                           Text="--"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForeground}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
