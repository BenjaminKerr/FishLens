<Page x:Class="FishLens_App.History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="History"
      Background="{DynamicResource WindowBackground}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{DynamicResource HeaderBackground}" 
                Padding="30,20">
            <StackPanel>
                <TextBlock Text="Reports &amp; Analytics" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource OnAccentForeground}"/>
              
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="30,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Filters" 
                                   FontSize="{DynamicResource LargeFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Date Range" 
                                       FontSize="{DynamicResource BaseFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>

                            <Button Content="Select Entire Date Range" 
                                    Click="AllDatesClick"
                                    Background="{DynamicResource CardBackground}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="10,6"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="startDatePicker"
                                        Grid.Column="0"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Padding="10,8"
                                        FontSize="{DynamicResource BaseFontSize}"/>

                            <TextBlock Grid.Column="1" 
                                       Text="—" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}"/>

                            <DatePicker x:Name="endDatePicker"
                                        Grid.Column="2"
                                        Background="{DynamicResource WindowBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        Padding="10,8"
                                        FontSize="{DynamicResource BaseFontSize}"/>
                        </Grid>

                        <TextBlock Text="Species" 
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="speciesFilter"
                                  Background="{DynamicResource WindowBackground}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Species"/>
                            <ComboBoxItem Content="Trout"/>
                            <ComboBoxItem Content="Salmon"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Direction" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="directionFilter"
                                  Background="{DynamicResource WindowBackground}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Directions"/>
                            <ComboBoxItem Content="Upstream"/>
                            <ComboBoxItem Content="Downstream"/>
                        </ComboBox>

                        <TextBlock Text="Location" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="cameraFilter"
                                  Background="{DynamicResource WindowBackground}"
                                  BorderBrush="{DynamicResource BorderBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,20"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Locations"/>
                            <ComboBoxItem Content="Keno Dam"/>
                            <ComboBoxItem Content="Link River Dam"/>
                            <ComboBoxItem Content="Spencer Creek"/>
                        </ComboBox>

                        <TextBlock Text="Minimum Confidence" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="confidenceSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"/>

                            <TextBlock x:Name="confidenceValueText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="{DynamicResource BaseFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Filter detections below this confidence level" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,20"/>

                        <Button Content="Apply Filters" 
                                Click="ApplyFiltersClick"
                                Background="{DynamicResource HeaderBackground}"
                                Foreground="{DynamicResource OnAccentForeground}"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Clear Filters" 
                                Click="ClearFiltersClick"
                                Background="{DynamicResource CardBackground}"
                                Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                Cursor="Hand"
                                Margin="0,0,0,25">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" 
                    Margin="30,20,30,30" 
                    Background="{DynamicResource CardBackground}" 
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderBrush}"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{DynamicResource WindowBackground}" 
                            Padding="20,15"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock x:Name="viewTitle"
                                       Text="Analysis Report" 
                                       FontSize="{DynamicResource LargeFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <ComboBox x:Name="reportTypeCombo"
          FontSize="{DynamicResource BaseFontSize}"
          Padding="10,5"
          Width="180"
          SelectedIndex="0"
          SelectionChanged="ReportType_SelectionChanged">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox">
                                            <Setter Property="Background" Value="{DynamicResource CardBackground}"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Padding" Value="10,6"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBox">
                                                        <Grid>
                                                            <Border x:Name="Border"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="32"/>
                                                                    </Grid.ColumnDefinitions>

                                                                    <ContentPresenter Grid.Column="0"
                                                      Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Left"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"/>

                                                                    <Path Grid.Column="1"
                                          Data="M0,0 L4,4 L8,0"
                                          Stroke="{DynamicResource PrimaryText}"
                                          StrokeThickness="1.5"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>

                                                                    <ToggleButton Grid.ColumnSpan="2"
                                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Focusable="False"
                                                  ClickMode="Press">
                                                                        <ToggleButton.Template>
                                                                            <ControlTemplate TargetType="ToggleButton">
                                                                                <Border Background="Transparent"/>
                                                                            </ControlTemplate>
                                                                        </ToggleButton.Template>
                                                                    </ToggleButton>
                                                                </Grid>
                                                            </Border>

                                                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                                                <Border Background="{DynamicResource CardBackground}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Margin="0,4,0,0"
                                        Padding="4"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="200">
                                                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                                        <StackPanel IsItemsHost="True"/>
                                                                    </ScrollViewer>
                                                                </Border>
                                                            </Popup>
                                                        </Grid>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HeaderBackground}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsDropDownOpen" Value="True">
                                                                <Setter TargetName="Border" Property="BorderBrush" Value="{DynamicResource HeaderBackground}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.Style>

                                    <ComboBox.ItemContainerStyle>
                                        <Style TargetType="ComboBoxItem">
                                            <Setter Property="Padding" Value="10,8"/>
                                            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
                                            <Setter Property="FontSize" Value="{DynamicResource BaseFontSize}"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ComboBoxItem">
                                                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsHighlighted" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource WindowBackground}"/>
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource HeaderBackground}"/>
                                                                <Setter Property="Foreground" Value="{DynamicResource OnAccentForeground}"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ComboBox.ItemContainerStyle>

                                    <ComboBoxItem Content="Standard Report"/>
                                    <ComboBoxItem Content="Detailed Analysis"/>
                                    <ComboBoxItem Content="Summary Only"/>
                                    <ComboBoxItem Content="Data Table View"/>
                                </ComboBox>



                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="placeholderPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Text="📊" 
                                   FontSize="{DynamicResource LargeTitleFontSize}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.5"
                                   Foreground="{DynamicResource PrimaryText}"/>
                        <TextBlock Text="Generate a report" 
                                   FontSize="{DynamicResource LargeFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Configure your filters and click the button below" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <MediaElement x:Name="videoPlayer"
                                  Grid.Row="1"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Margin="20"
                                  Visibility="Collapsed"/>

                    <ScrollViewer x:Name="reportScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  Padding="30,20">
                        <StackPanel x:Name="reportPanel">
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="reportControls"
                            Grid.Row="2" 
                            Background="{DynamicResource WindowBackground}" 
                            Padding="20,15"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="Export Report" 
                                    Click="ExportReportClick"
                                    Background="{DynamicResource HeaderBackground}"
                                    Foreground="{DynamicResource OnAccentForeground}"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Print Report" 
                                    Click="PrintReportClick"
                                    Background="{DynamicResource CardBackground}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" 
                Background="{DynamicResource CardBackground}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Generate Report" 
                            Click="GenerateReportClick"
                            Background="{DynamicResource HeaderBackground}"
                            Foreground="{DynamicResource OnAccentForeground}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="SemiBold"
                            Padding="25,12"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>


