<Window x:Class="FishLens_App.AuthWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FishLens_App"
        mc:Ignorable="d"
        Title="FishLens"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="{DynamicResource WindowBackground}">

    <Window.Resources>

        <!-- ── ROUNDED BUTTON BASE ── -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.75"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── PRIMARY ACTION BUTTON ── -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource RoundedButton}">
            <Setter Property="Background"      Value="{DynamicResource HeaderBackground}"/>
            <Setter Property="Foreground"      Value="{DynamicResource OnAccentForeground}"/>
            <Setter Property="FontSize"        Value="14"/>
            <Setter Property="FontWeight"      Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height"          Value="44"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="Padding"         Value="0"/>
        </Style>

        <!-- ── ROUNDED TEXTBOX ── -->
        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#EEF4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height"                    Value="42"/>
            <Setter Property="Foreground"                Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush"                Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize"                  Value="14"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
        </Style>

        <!-- ── ROUNDED PASSWORDBOX ── -->
        <Style x:Key="RoundedPasswordBox" TargetType="PasswordBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                Background="{DynamicResource CardBackground}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="12,0"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="border" Property="Background" Value="#EEF4F6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Height"                    Value="42"/>
            <Setter Property="Foreground"                Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush"                Value="{DynamicResource AccentBrush}"/>
            <Setter Property="FontSize"                  Value="14"/>
            <Setter Property="BorderThickness"           Value="1"/>
            <Setter Property="VerticalContentAlignment"  Value="Center"/>
        </Style>

        <!-- ── FIELD LABEL ── -->
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin"     Value="0,0,0,6"/>
        </Style>

        <!-- ── LINK / CLICKABLE TEXT ── -->
        <Style x:Key="LinkText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="FontSize"   Value="12"/>
            <Setter Property="Cursor"     Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- ── HINT TEXT ── -->
        <Style x:Key="HintText" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="11"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}"/>
            <Setter Property="Margin"     Value="0,3,0,0"/>
        </Style>

        <!-- ── ERROR TEXT ── -->
        <Style x:Key="ErrorText" TargetType="TextBlock">
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Foreground"   Value="#E53935"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin"       Value="0,4,0,0"/>
            <Setter Property="Visibility"   Value="Collapsed"/>
        </Style>

        <!-- ── ACTIVE TAB PILL ── -->
        <Style x:Key="ActiveTabPill" TargetType="Border">
            <Setter Property="Background"   Value="{DynamicResource HeaderBackground}"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  HEADER                                                -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                Padding="40,18">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Logo mark (fish/lens SVG via Viewbox) -->
                <Viewbox Width="32" Height="32" Margin="0,0,12,0">
                    <Canvas Width="38" Height="38">
                        <!-- Magnifying Glass Lens -->
                        <Ellipse Canvas.Left="1" Canvas.Top="1"
                 Width="36" Height="36"
                 Stroke="#2D7A64" StrokeThickness="1"
                 Fill="#0F3E30"/>

                        <!-- Handle -->
                        <Path Data="M 27,27 L 35,35"
          Stroke="#2D7A64" StrokeThickness="2.5"
          StrokeStartLineCap="Round" StrokeEndLineCap="Round" Canvas.Left="4.947" Canvas.Top="4.75"/>

                        <!-- fish body -->
                        <!-- eye -->
                        <!-- tail fins -->
                    </Canvas>
                </Viewbox>

                <!-- Brand wordmark -->
                <TextBlock VerticalAlignment="Center">
                    <Run Text="FishLens"
                         FontFamily="Georgia"
                         FontSize="22"
                         FontWeight="SemiBold"
                         Foreground="{DynamicResource OnAccentForeground}"/>
                </TextBlock>

            </StackPanel>
        </Border>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  CONTENT — five panels, one visible at a time         -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">

            <!-- ─────────────────────────────────────────── -->
            <!--  PANEL 1 · SIGN IN                          -->
            <!-- ─────────────────────────────────────────── -->
            <Border x:Name="SignInPanel"
                    Visibility="Visible"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <!-- Tab switcher -->
                    <Border Background="{DynamicResource WindowBackground}"
                            CornerRadius="8"
                            Padding="3"
                            Margin="0,0,0,24">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource ActiveTabPill}">
                                <TextBlock Text="Sign In"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource OnAccentForeground}"
                                           HorizontalAlignment="Center"
                                           Margin="0,8"/>
                            </Border>

                            <TextBlock Grid.Column="1"
                                       Text="Create Account"
                                       FontSize="13"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,8"
                                       Style="{StaticResource LinkText}"
                                       MouseLeftButtonUp="GoToSignUp_Click"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Sign in to your account"
                               FontFamily="Georgia"
                               FontSize="22"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,24"/>

                    <!-- Username -->
                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="SignInUsernameBox"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,14"
                             TabIndex="0"
                             KeyDown="SignInUsername_KeyDown"
                             GotKeyboardFocus="UsernameBox_GotKeyFocus"/>

                    <!-- Password -->
                    <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="SignInPasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 Margin="0,0,0,4"
                                 TabIndex="1"
                                 KeyDown="SignInPassword_KeyDown"
                                 GotKeyboardFocus="PasswordBox_GotKeyFocus"/>

                    <TextBlock Text="Forgot password?"
                               Style="{StaticResource LinkText}"
                               HorizontalAlignment="Right"
                               Margin="0,4,0,16"
                               MouseLeftButtonUp="GoToForgotPassword_Click"/>

                    <TextBlock x:Name="SignInError"
                               Style="{StaticResource ErrorText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <Button Content="Sign In"
                            Style="{StaticResource PrimaryButton}"
                            TabIndex="2"
                            Click="SigninButton_Click"/>

                </StackPanel>
            </Border>

            <!-- ─────────────────────────────────────────── -->
            <!--  PANEL 2 · SIGN UP                          -->
            <!-- ─────────────────────────────────────────── -->
            <Border x:Name="SignUpPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- Tab switcher -->
                        <Border Background="{DynamicResource WindowBackground}"
                                CornerRadius="8"
                                Padding="3"
                                Margin="0,0,0,24">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="Sign In"
                                           FontSize="13"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Margin="0,8"
                                           Style="{StaticResource LinkText}"
                                           MouseLeftButtonUp="GoToSignIn_Click"/>

                                <Border Grid.Column="1" Style="{StaticResource ActiveTabPill}">
                                    <TextBlock Text="Create Account"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource OnAccentForeground}"
                                               HorizontalAlignment="Center"
                                               Margin="0,8"/>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="Create your organization"
                                   FontFamily="Georgia"
                                   FontSize="22"
                                   Foreground="{DynamicResource PrimaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,24"/>

                        <!-- Org Name -->
                        <TextBlock Text="ORGANIZATION NAME" Style="{StaticResource FieldLabel}"/>
                        <TextBox x:Name="OrgNameBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="OrgNameError" Style="{StaticResource ErrorText}" Margin="0,0,0,12"/>

                        <!-- Email -->
                        <TextBlock Text="EMAIL" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                        <TextBox x:Name="NewEmailBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,4"/>
                        <TextBlock Text="• Must be a valid address (e.g. name@gmail.com)"
                                   Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="EmailError" Style="{StaticResource ErrorText}" Margin="0,0,0,12"/>

                        <!-- Username -->
                        <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                        <TextBox x:Name="NewUsernameBox"
                                 Style="{StaticResource RoundedTextBox}"
                                 Margin="0,0,0,4"/>
                        <TextBlock x:Name="ReqSignUpUsernameLength"
                                   Text="• At least 6 characters"
                                   Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="UsernameError" Style="{StaticResource ErrorText}" Margin="0,0,0,12"/>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                        <PasswordBox x:Name="NewPasswordBox"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     Margin="0,0,0,4"/>
                        <TextBlock x:Name="ReqSignUpPasswordLength"
                                   Text="• At least 6 characters"
                                   Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="PasswordError" Style="{StaticResource ErrorText}" Margin="0,0,0,12"/>

                        <!-- Confirm Password -->
                        <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}" Margin="0,8,0,6"/>
                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Style="{StaticResource RoundedPasswordBox}"
                                     Margin="0,0,0,4"/>
                        <TextBlock x:Name="ReqSignUpPasswordMatch"
                                   Text="• Passwords must match"
                                   Style="{StaticResource HintText}"/>
                        <TextBlock x:Name="ConfirmPasswordError" Style="{StaticResource ErrorText}" Margin="0,0,0,12"/>

                        <Button Content="Create Account"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,16,0,0"
                                Click="CreateAccount_Click"/>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ─────────────────────────────────────────── -->
            <!--  PANEL 3 · VERIFY EMAIL                     -->
            <!-- ─────────────────────────────────────────── -->
            <Border x:Name="VerifyEmailPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="← Back"
                               Style="{StaticResource LinkText}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,20"
                               MouseLeftButtonUp="BackToSignUpPanel_Click"/>

                    <TextBlock Text="Verify your email"
                               FontFamily="Georgia"
                               FontSize="22"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="We sent a 6-digit code to your email address. Enter it below to finish creating your account."
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="VERIFICATION CODE" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="VerificationCodeBox"
                             Style="{StaticResource RoundedTextBox}"
                             MaxLength="6"
                             Margin="0,0,0,4"/>

                    <TextBlock x:Name="VerifyError"
                               Style="{StaticResource ErrorText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <Button Content="Verify &amp; Create Account"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,16"
                            Click="VerifyCode_Click"/>

                    <TextBlock Text="Resend code"
                               Style="{StaticResource LinkText}"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               MouseLeftButtonUp="ResendSignUpCode_Click"/>

                </StackPanel>
            </Border>

            <!-- ─────────────────────────────────────────── -->
            <!--  PANEL 4 · FORGOT PASSWORD                  -->
            <!-- ─────────────────────────────────────────── -->
            <Border x:Name="ForgotPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="← Back to Sign In"
                               Style="{StaticResource LinkText}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,20"
                               MouseLeftButtonUp="BackToSignInFromForgot_Click"/>

                    <TextBlock Text="ACCOUNT RECOVERY"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,4"/>

                    <TextBlock Text="Reset your password"
                               FontFamily="Georgia"
                               FontSize="22"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Enter your username and we'll send a reset code to your email."
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ForgotUsernameBox"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,4"/>

                    <TextBlock x:Name="ForgotError"
                               Style="{StaticResource ErrorText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <Button Content="Send Reset Code"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,12,0,0"
                            Click="SendResetCode_Click"/>

                </StackPanel>
            </Border>

            <!-- ─────────────────────────────────────────── -->
            <!--  PANEL 5 · RESET PASSWORD                   -->
            <!-- ─────────────────────────────────────────── -->
            <Border x:Name="ResetPanel"
                    Visibility="Collapsed"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="32,28"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="← Back"
                               Style="{StaticResource LinkText}"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,20"
                               MouseLeftButtonUp="BackToForgotFromReset_Click"/>

                    <TextBlock Text="Choose a new password"
                               FontFamily="Georgia"
                               FontSize="22"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="Enter the 6-digit code from your email, then set your new password."
                               FontSize="13"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,0,0,24"/>

                    <TextBlock Text="RESET CODE" Style="{StaticResource FieldLabel}"/>
                    <TextBox x:Name="ResetCodeBox"
                             Style="{StaticResource RoundedTextBox}"
                             Margin="0,0,0,14"/>

                    <TextBlock Text="NEW PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ResetNewPasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 Margin="0,0,0,4"/>
                    <TextBlock x:Name="ReqResetPasswordLength"
                               Text="• At least 6 characters"
                               Style="{StaticResource HintText}"
                               Margin="0,0,0,14"/>

                    <TextBlock Text="CONFIRM PASSWORD" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ResetConfirmPasswordBox"
                                 Style="{StaticResource RoundedPasswordBox}"
                                 Margin="0,0,0,4"/>
                    <TextBlock x:Name="ReqResetPasswordMatch"
                               Text="• Passwords must match"
                               Style="{StaticResource HintText}"/>

                    <TextBlock x:Name="ResetError"
                               Style="{StaticResource ErrorText}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0"/>

                    <Button Content="Reset Password"
                            Style="{StaticResource PrimaryButton}"
                            Margin="0,16,0,0"
                            Click="ResetPassword_Click"/>

                </StackPanel>
            </Border>

        </Grid>

        <!-- ══════════════════════════════════════════════════════ -->
        <!--  FOOTER                                                -->
        <!-- ══════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="40,16">

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">

                <TextBlock Text="Privacy"
                           Style="{StaticResource LinkText}"
                           Margin="0,0,20,0"/>

                <Ellipse Width="3" Height="3"
                         Fill="{DynamicResource BorderBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,20,0"/>

                <TextBlock Text="Terms"
                           Style="{StaticResource LinkText}"
                           Margin="0,0,20,0"/>

                <Ellipse Width="3" Height="3"
                         Fill="{DynamicResource BorderBrush}"
                         VerticalAlignment="Center"
                         Margin="0,0,20,0"/>

                <TextBlock Text="Support"
                           Style="{StaticResource LinkText}"/>

            </StackPanel>
        </Border>

    </Grid>
</Window>
