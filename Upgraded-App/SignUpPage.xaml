<Window x:Class="FishLens_App.SignUpPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign Up"
        Width="1000" Height="700"
          WindowStartupLocation="CenterScreen"
  ResizeMode="NoResize"
  WindowState="Maximized"
        Background="#0D3640">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                Padding="30,20">
            <TextBlock Text="FishLens"
                       FontSize="{DynamicResource LargeHeaderFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OnAccentForeground}"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="25"
                    Margin="30"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Create your account"
                               FontSize="{DynamicResource LargeHeaderFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,5"/>

                    <TextBlock Text="Set up your organization and admin account"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,25"/>

                    <!-- Organization Name -->
                    <TextBlock Text="Organization Name"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBox x:Name="OrgName"
                             Height="36"
                             Padding="8"
                             FontSize="{DynamicResource BaseFontSize}"
                             Margin="0,5,0,15"/>

                    <!-- Username -->
                    <TextBlock Text="Username"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBox x:Name="NewUsername"
                             Height="36"
                             Padding="8"
                             FontSize="{DynamicResource BaseFontSize}"
                             Margin="0,5,0,15"/>

                    <!-- Password -->
                    <TextBlock Text="Password"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <PasswordBox x:Name="NewPassword"
                                 Height="36"
                                 Padding="8"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Margin="0,5,0,15"/>

                    <!-- Confirm Password -->
                    <TextBlock Text="Confirm Password"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <PasswordBox x:Name="ConfirmPassword"
                                 Height="36"
                                 Padding="8"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Margin="0,5,0,5"/>

                    <!-- Error message -->
                    <TextBlock x:Name="ErrorMessage"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="#F44336"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"
                               Visibility="Collapsed"/>

                    <!-- Sign Up Button -->
                    <Button Content="Create Account"
                            Width="160"
                            Padding="10,8"
                            Background="{DynamicResource HeaderBackground}"
                            Foreground="{DynamicResource OnAccentForeground}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            Margin="0,10,0,0"
                            Click="CreateAccount_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBackground}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0"
                Padding="30,20">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Center">

                <TextBlock Text="Already have an account?"
                           FontSize="{DynamicResource BaseFontSize}"
                           Foreground="{DynamicResource SecondaryText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>

                <TextBlock Text="Sign In"
                           FontSize="{DynamicResource BaseFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryTextBrush}"
                           VerticalAlignment="Center"
                           Cursor="Hand"
                           MouseLeftButtonUp="SignIn_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>
    </Grid>
</Window>





