<Window x:Class="FishLens_App.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FishLens_App"
        mc:Ignorable="d"
        Title="Reset Password"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#0D3640">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                Padding="30,20">
            <TextBlock Text="FishLens"
                       FontSize="{DynamicResource LargeHeaderFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OnAccentForeground}"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="25"
                    Margin="30"
                    Width="420"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                

                <StackPanel>

                    <!-- Step 1: Enter username -->
                    <StackPanel x:Name="EmailStep">

                        <TextBlock Text="Reset your password"
                                   FontSize="{DynamicResource LargeHeaderFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Enter your username to receive a reset code"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Username"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"/>

                        <TextBox x:Name="UsernameBox"
                                 Height="36"
                                 Padding="8"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Margin="0,5,0,20"/>

                        <Button Content="Send Reset Code"
                                Width="160"
                                Padding="10,8"
                                Background="{DynamicResource HeaderBackground}"
                                Foreground="{DynamicResource OnAccentForeground}"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Click="SendCode_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <!-- Step 2: Enter code and new password -->
                    <StackPanel x:Name="ResetStep" Visibility="Collapsed">

                        <TextBlock Text="Enter your reset code"
                                   FontSize="{DynamicResource LargeHeaderFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,5"/>

                        <TextBlock Text="Check your email for the 6-digit code"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <TextBlock Text="Reset Code"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"/>

                        <TextBox x:Name="CodeBox"
                                 Height="36"
                                 Padding="8"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Margin="0,5,0,15"/>

                        <TextBlock Text="New Password"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock x:Name="ReqNewPasswordLength"
                         Text="• At least 6 characters"
                         FontSize="11"
                         Foreground="#888888"
                         Margin="0,2,0,10"/>


                        <PasswordBox x:Name="NewPasswordBox"
                                     Height="36"
                                     Padding="8"
                                     FontSize="{DynamicResource BaseFontSize}"
                                     Margin="0,5,0,15"/>

                        <TextBlock Text="Confirm Password"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"/>
                        <TextBlock x:Name="ReqPasswordMatch"
                                    Text="• Passwords must match"
                                    FontSize="11"
                                    Foreground="#888888"
                                    Margin="0,2,0,10"/>


                        <PasswordBox x:Name="ConfirmPasswordBox"
                                     Height="36"
                                     Padding="8"
                                     FontSize="{DynamicResource BaseFontSize}"
                                     Margin="0,5,0,5"/>

                        <!-- Error message -->
                        <TextBlock x:Name="ErrorMessage"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="#F44336"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,10"
                                   Visibility="Collapsed"/>

                        <Button Content="Reset Password"
                                Width="160"
                                Padding="10,8"
                                Background="{DynamicResource HeaderBackground}"
                                Foreground="{DynamicResource OnAccentForeground}"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                BorderThickness="0"
                                HorizontalAlignment="Center"
                                Cursor="Hand"
                                Margin="0,10,0,0"
                                Click="ResetPassword_Click">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                </StackPanel>
            </Border>
            
        </Grid>
        <!-- Footer -->
        <Border Grid.Row="2"
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,1,0,0"
        Padding="30,20">

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                <TextBlock Text="Remember your password?"
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryText}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

                <TextBlock Text="Back to Sign In"
                   FontSize="{DynamicResource BaseFontSize}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryTextBrush}"
                   VerticalAlignment="Center"
                   Cursor="Hand"
                   MouseLeftButtonUp="BackToSignIn_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>

    </Grid>
</Window>


