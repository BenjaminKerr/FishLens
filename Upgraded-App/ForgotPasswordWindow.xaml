<Window x:Class="FishLens_App.ForgotPasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:FishLens_App"
        mc:Ignorable="d"
        Title="ForgotPasswordWindow" Height="350" Width="400">

    <StackPanel Margin="20">
        <StackPanel x:Name="EmailStep">
            <TextBlock Text="Enter your username:" Margin="0,0,0,5" />
            <TextBox x:Name="UsernameBox" Margin="0,0,0,10" />
            <Button Content="Send Reset Code" Click="SendCode_Click" />
        </StackPanel>

        <!-- Step 2: Enter code and new password (hidden initially) -->
        <StackPanel x:Name="ResetStep" Visibility="Collapsed">
            <TextBlock Text="Enter the code sent to your email:" Margin="0,0,0,5" />
            <TextBox x:Name="CodeBox" Margin="0,0,0,10" />

            <TextBlock Text="New Password:" Margin="0,0,0,5" />
            <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,10" />

            <TextBlock Text="Confirm Password:" Margin="0,0,0,5" />
            <PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,10" />

            <Button Content="Reset Password" Click="ResetPassword_Click" />
        </StackPanel>

    </StackPanel>

</Window>
