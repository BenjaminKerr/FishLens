<!-- ***************************************************************************************************************************
// File: SigninPage.xaml
// Description: This is the xaml code for our signin page which contains the design of the page.
// Notes: Currently the login functionality is temporary, it does not actually check login information only whether or not it 
// contains text.
// ***************************************************************************************************************************-->
    <Window x:Class="FishLens_App.SigninPage"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in"
        Width="1000" Height="700"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="#0D3640">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="{DynamicResource HeaderBackground}"
                Padding="30,20">
            <TextBlock Text="FishLens"
                       FontSize="{DynamicResource LargeHeaderFontSize}"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource OnAccentForeground}"/>
        </Border>

        <!-- Content -->
        <Grid Grid.Row="1">

            <!-- Add spacing using Margin instead -->
            <Border Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="25"
                    Margin="30"
                    Width="400"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>

                    <TextBlock Text="Sign in"
                               FontSize="{DynamicResource LargeHeaderFontSize}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <TextBlock Text="Username"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <TextBox x:Name="UserName"
                             Height="36"
                             Padding="8"
                             FontSize="{DynamicResource BaseFontSize}"
                             Margin="0,5,0,15"
                             TabIndex="0"
                             KeyDown="TextBox_KeyDown"
                             GotKeyboardFocus="UsernameBox_GotKeyFocus"/>

                    <TextBlock Text="Password"
                               FontSize="{DynamicResource BaseFontSize}"
                               Foreground="{DynamicResource SecondaryText}"/>

                    <PasswordBox x:Name="PassWord"
                                 Height="36"
                                 Padding="8"
                                 FontSize="{DynamicResource BaseFontSize}"
                                 Margin="0,5,0,20"
                                 TabIndex="1"
                                 KeyDown="PasswordBox_KeyDown"
                                 GotKeyboardFocus="PasswordBox_GotKeyFocus"/>

                    <!-- Sign In Button -->
                    <Button x:Name="SignInButton"
                            Content="Sign In"
                            Width="140"
                            Padding="10,6"
                            Background="{DynamicResource HeaderBackground}"
                            Foreground="{DynamicResource OnAccentForeground}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="SemiBold"
                            BorderThickness="0"
                            HorizontalAlignment="Center"
                            Cursor="Hand"
                            TabIndex="2"
                            Click="SigninButtonClick">

                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>

                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.85"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>

                    </Button>
                    <TextBlock Text="Forgot Password?"
   FontSize="{DynamicResource BaseFontSize}"
   FontWeight="SemiBold"
   Foreground="{DynamicResource SecondaryText}"
   HorizontalAlignment="Center"
   Cursor="Hand"
   MouseLeftButtonUp="ForgotPassword_Click" Margin="0,10,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>



                </StackPanel>
            </Border>
        </Grid>

        <!-- Footer -->
        <Border Grid.Row="2"
        Background="{DynamicResource CardBackground}"
        BorderBrush="{DynamicResource BorderBrush}"
        BorderThickness="0,1,0,0"
        Padding="30,20">

            <StackPanel Orientation="Horizontal"
                HorizontalAlignment="Center">

                <TextBlock Text="Don't have an account?"
                   FontSize="{DynamicResource BaseFontSize}"
                   Foreground="{DynamicResource SecondaryText}"
                   VerticalAlignment="Center"
                   Margin="0,0,8,0"/>

                <TextBlock Text="Sign Up"
                   FontSize="{DynamicResource BaseFontSize}"
                   FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}"
                   VerticalAlignment="Center"
                   Cursor="Hand"
                   MouseLeftButtonUp="SignUp_Click">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

            </StackPanel>
        </Border>



    </Grid>
</Window>
