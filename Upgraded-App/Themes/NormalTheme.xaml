<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#F5F8FA"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#0D3640"/>
    <SolidColorBrush x:Key="CardBackground" Color="White"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#0D3640"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#8BA5AE"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1B4F5C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E1E8ED"/>

    <!-- Aliases for older XAML resource names used across the app -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#F5F8FA"/>
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="#1B4F5C"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#8BA5AE"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="#0D3640"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="#E1E8ED"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="White"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2D7A8F"/>
    <SolidColorBrush x:Key="OnAccentForeground" Color="White"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
    <!-- Action button disabled-state colors -->
    <SolidColorBrush x:Key="AccentButtonDisabledBackground" Color="#081E27"/>
    <SolidColorBrush x:Key="AccentButtonDisabledForeground" Color="#3D6878"/>
    <SolidColorBrush x:Key="NeutralButtonDisabledBackground" Color="#C2CDD1"/>
    <SolidColorBrush x:Key="NeutralButtonDisabledForeground" Color="#7A9299"/>
    <SolidColorBrush x:Key="SidebarBorder" Color="#1B4F5C"/>
</ResourceDictionary>