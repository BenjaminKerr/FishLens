<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════════════
         SLIM SCROLLBAR — vertical + horizontal, no layout shift
    ════════════════════════════════════════════════════════════ -->

    <!-- Shared thumb template — scoped to a key so it doesn't
         clobber Slider thumbs (which have their own templates). -->
    <ControlTemplate x:Key="ScrollThumbTemplate" TargetType="Thumb">
        <Border x:Name="ThumbBorder"
                Background="{DynamicResource AccentBrush}"
                CornerRadius="5"
                Opacity="0.45"/>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="ThumbBorder" Property="Opacity" Value="0.75"/>
            </Trigger>
            <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="ThumbBorder" Property="Opacity" Value="1"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style TargetType="ScrollBar">
        <Setter Property="Background"        Value="Transparent"/>
        <Setter Property="BorderThickness"   Value="0"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <!-- Default = vertical. Width is fixed at 12 always;
             thumb margin controls the visual slim/expand feel
             without reflowing content. -->
        <Setter Property="Width"  Value="12"/>
        <Setter Property="MinWidth" Value="12"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" Width="12">

                        <!-- Subtle track pill -->
                        <Border CornerRadius="5"
                                Background="{DynamicResource BorderBrush}"
                                Opacity="0.25"
                                Margin="4,4,4,4"
                                HorizontalAlignment="Center"
                                Width="4"/>

                        <Track x:Name="PART_Track"
                               IsDirectionReversed="True"
                               VerticalAlignment="Stretch">

                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineUpCommand"
                                              Opacity="0" IsEnabled="False"
                                              Focusable="False"/>
                            </Track.DecreaseRepeatButton>

                            <Track.Thumb>
                                <!-- Margin: 3,0 = slim (6px visual); 1,0 on hover = wider (10px).
                                     Layout width stays 12px so no reflow. -->
                                <Thumb x:Name="PART_Thumb"
                                       Margin="3,0"
                                       Template="{StaticResource ScrollThumbTemplate}"/>
                            </Track.Thumb>

                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.LineDownCommand"
                                              Opacity="0" IsEnabled="False"
                                              Focusable="False"/>
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Thumb visually expands on hover via margin,
                             no width change on the ScrollBar itself -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Thumb" Property="Margin" Value="1,0"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <!-- Horizontal orientation override -->
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Height"    Value="12"/>
                <Setter Property="MinHeight" Value="12"/>
                <Setter Property="Width"     Value="Auto"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" Height="12">

                                <Border CornerRadius="5"
                                        Background="{DynamicResource BorderBrush}"
                                        Opacity="0.25"
                                        Margin="4,4,4,4"
                                        VerticalAlignment="Center"
                                        Height="4"/>

                                <Track x:Name="PART_Track"
                                       IsDirectionReversed="False"
                                       HorizontalAlignment="Stretch">

                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineLeftCommand"
                                                      Opacity="0" IsEnabled="False"
                                                      Focusable="False"/>
                                    </Track.DecreaseRepeatButton>

                                    <Track.Thumb>
                                        <Thumb x:Name="PART_Thumb"
                                               Margin="0,3"
                                               Template="{StaticResource ScrollThumbTemplate}"/>
                                    </Track.Thumb>

                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Command="ScrollBar.LineRightCommand"
                                                      Opacity="0" IsEnabled="False"
                                                      Focusable="False"/>
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>

                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_Thumb" Property="Margin" Value="0,1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
