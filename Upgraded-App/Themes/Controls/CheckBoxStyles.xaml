<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- ═══════════════════════════════════════════════════════════
         SIDEBAR CHECKBOX — white ring at rest, accent fill when checked
    ════════════════════════════════════════════════════════════ -->
	<Style TargetType="CheckBox">
		<Setter Property="SnapsToDevicePixels" Value="True"/>
		<Setter Property="Focusable"           Value="False"/>
		<Setter Property="Cursor"              Value="Hand"/>
		<Setter Property="Template">
			<Setter.Value>
				<ControlTemplate TargetType="CheckBox">
					<Grid VerticalAlignment="Center" HorizontalAlignment="Center">
						<Border x:Name="Ring"
                                Width="16" Height="16"
                                CornerRadius="8"
                                BorderThickness="1.5"
                                BorderBrush="{DynamicResource OnAccentForeground}"
                                Background="Transparent"
                                Opacity="0.45"/>
						<Border x:Name="Fill"
                                Width="16" Height="16"
                                CornerRadius="8"
                                Background="{DynamicResource OnAccentForeground}"
                                Visibility="Collapsed"/>
						<TextBlock x:Name="Check"
                                   Text="✓"
                                   FontSize="9"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Visibility="Collapsed"/>
					</Grid>
					<ControlTemplate.Triggers>
						<Trigger Property="IsMouseOver" Value="True">
							<Setter TargetName="Ring" Property="Opacity" Value="0.75"/>
						</Trigger>
						<Trigger Property="IsChecked" Value="True">
							<Setter TargetName="Ring"  Property="Visibility" Value="Collapsed"/>
							<Setter TargetName="Fill"  Property="Visibility" Value="Visible"/>
							<Setter TargetName="Check" Property="Visibility" Value="Visible"/>
						</Trigger>
					</ControlTemplate.Triggers>
				</ControlTemplate>
			</Setter.Value>
		</Setter>
	</Style>

</ResourceDictionary>