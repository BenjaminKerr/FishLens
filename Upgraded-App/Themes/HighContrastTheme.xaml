<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Pure black/white = maximum 21:1 contrast -->
    <SolidColorBrush x:Key="WindowBackground" Color="Black"/>
    <SolidColorBrush x:Key="CardBackground" Color="Black"/>
    <SolidColorBrush x:Key="PrimaryText" Color="White"/>
    <SolidColorBrush x:Key="BorderBrush" Color="White"/>

    <!-- Buttons: white background + black text (21:1) for strong action surfaces -->
    <SolidColorBrush x:Key="HeaderBackground" Color="White"/>
    <SolidColorBrush x:Key="OnAccentForeground" Color="Black"/>

    <!-- Yellow accent — readable on black (19.5:1) and color-blind friendly -->
    <SolidColorBrush x:Key="AccentBrush" Color="#FFFF00"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#FFFF00"/>

    <!-- Hover state — invert to make it obvious -->
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#FFFF00"/>

</ResourceDictionary>


