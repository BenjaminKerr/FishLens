<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="WindowBackground" Color="#181A1B"/>
    <SolidColorBrush x:Key="HeaderBackground" Color="#23272A"/>
    <SolidColorBrush x:Key="CardBackground" Color="#23272A"/>
    <SolidColorBrush x:Key="PrimaryText" Color="#F5F8FA"/>
    <SolidColorBrush x:Key="SecondaryText" Color="#B0B3B8"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#1B4F5C"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#444950"/>

    <!-- Aliases for older XAML resource names used across the app -->
    <SolidColorBrush x:Key="PageBackgroundBrush" Color="#181A1B"/>
    <SolidColorBrush x:Key="PrimaryColorBrush" Color="#1B4F5C"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="#F5F8FA"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="White"/>
    <SolidColorBrush x:Key="BorderColorBrush" Color="#444950"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="#23272A"/>
    <SolidColorBrush x:Key="HoverBackgroundBrush" Color="#2D7A8F"/>
    <SolidColorBrush x:Key="OnAccentForeground" Color="#F5F8FA"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="White"/>
    <!-- Action button disabled-state colors -->
    <SolidColorBrush x:Key="AccentButtonDisabledBackground" Color="#1A1A1A"/>
    <SolidColorBrush x:Key="AccentButtonDisabledForeground" Color="#444444"/>
    <SolidColorBrush x:Key="NeutralButtonDisabledBackground" Color="#333333"/>
    <SolidColorBrush x:Key="NeutralButtonDisabledForeground" Color="#666666"/>
</ResourceDictionary>