<Page x:Class="FishLens_App.History"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Background="#F5F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#0D3640" 
                Padding="30,25">
            <StackPanel>
                <TextBlock Text="Reports &amp; Analytics" 
                           FontSize="32" 
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Filter, analyze, and export your detection data" 
                           FontSize="14" 
                           Foreground="#B0C4CB"
                           FontWeight="Normal"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Filters & Controls Panel -->
            <Border Grid.Column="0"
                    Background="White"
                    BorderBrush="#E1E8ED"
                    BorderThickness="0,0,1,0"
                    Padding="30,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Filters Section -->
                        <TextBlock Text="🔍 Filters" 
                                   FontSize="18" 
                                   FontWeight="SemiBold"
                                   Foreground="#0D3640"
                                   Margin="0,0,0,15"/>

                        <!-- Date Range Filter with Button -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Date Range" 
                                       FontSize="13" 
                                       FontWeight="SemiBold"
                                       Foreground="#14171A"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>

                            <Button Content="Select Entire Date Range" 
                                    Click="AllDatesClick"
                                    Background="White"
                                    Foreground="#0D3640"
                                    BorderBrush="#C7D8DD"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="10,6"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F8FA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="startDatePicker"
                                        Grid.Column="0"
                                        Background="#F5F8FA"
                                        BorderBrush="#C7D8DD"
                                        Padding="10,8"
                                        FontSize="12"/>

                            <TextBlock Grid.Column="1" 
                                       Text="—" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       Foreground="#8BA5AE"/>

                            <DatePicker x:Name="endDatePicker"
                                        Grid.Column="2"
                                        Background="#F5F8FA"
                                        BorderBrush="#C7D8DD"
                                        Padding="10,8"
                                        FontSize="12"/>
                        </Grid>

                        <!-- Species Filter -->
                        <TextBlock Text="Species" 
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="#14171A"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="speciesFilter"
                                  Background="#F5F8FA"
                                  BorderBrush="#C7D8DD"
                                  Padding="12,8"
                                  FontSize="13"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Species"/>
                            <ComboBoxItem Content="Trout"/>
                            <ComboBoxItem Content="Salmon"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <!-- Direction Filter -->
                        <TextBlock Text="Direction" 
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="#14171A"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="directionFilter"
                                  Background="#F5F8FA"
                                  BorderBrush="#C7D8DD"
                                  Padding="12,8"
                                  FontSize="13"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Directions"/>
                            <ComboBoxItem Content="Upstream"/>
                            <ComboBoxItem Content="Downstream"/>
                        </ComboBox>

                        <!-- Camera/Video Filter -->
                        <TextBlock Text="Location" 
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="#14171A"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="cameraFilter"
                                  Background="#F5F8FA"
                                  BorderBrush="#C7D8DD"
                                  Padding="12,8"
                                  FontSize="13"
                                  Margin="0,0,0,20"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Locations"/>
                            <ComboBoxItem Content="Keno Dam"/>
                            <ComboBoxItem Content="Link River Dam"/>
                            <ComboBoxItem Content="Spencer Creek"/>
                        </ComboBox>

                        <!-- Filter Action Buttons -->
                        <Button Content="Apply Filters" 
                                Click="ApplyFiltersClick"
                                Background="#0D3640"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#165666"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Clear Filters" 
                                Click="ClearFiltersClick"
                                Background="White"
                                Foreground="#0D3640"
                                BorderBrush="#C7D8DD"
                                BorderThickness="1"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                Cursor="Hand"
                                Margin="0,0,0,25">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F5F8FA"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Report Display Panel -->
            <Border Grid.Column="1" 
                    Margin="30,20,30,30" 
                    Background="White" 
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#C7D8DD"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Report Header -->
                    <Border Grid.Row="0" 
                            Background="#F5F8FA" 
                            Padding="20,15"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock x:Name="viewTitle"
                                       Text="Analysis Report" 
                                       FontSize="16" 
                                       FontWeight="SemiBold"
                                       Foreground="#0D3640"
                                       VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <ComboBox x:Name="reportTypeCombo"
                                          FontSize="12"
                                          Padding="10,5"
                                          Background="White"
                                          BorderBrush="#C7D8DD"
                                          SelectedIndex="0"
                                          SelectionChanged="ReportType_SelectionChanged">
                                    <ComboBoxItem Content="Standard Report"/>
                                    <ComboBoxItem Content="Detailed Analysis"/>
                                    <ComboBoxItem Content="Summary Only"/>
                                    <ComboBoxItem Content="Data Table View"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Placeholder when no report generated -->
                    <StackPanel x:Name="placeholderPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Text="📊" 
                                   FontSize="80" 
                                   HorizontalAlignment="Center"
                                   Opacity="0.3"/>
                        <TextBlock Text="Generate a report" 
                                   FontSize="16" 
                                   Foreground="#8BA5AE"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Configure your filters and click the button below" 
                                   FontSize="14" 
                                   Foreground="#8BA5AE"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Video Player (kept for compatibility) -->
                    <MediaElement x:Name="videoPlayer"
                                  Grid.Row="1"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Margin="20"
                                  Visibility="Collapsed"/>

                    <!-- Report View -->
                    <ScrollViewer x:Name="reportScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  Padding="30,20">
                        <StackPanel x:Name="reportPanel">
                            <!-- Report content will be added dynamically -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- History List (for reference) -->
                    <ScrollViewer x:Name="historyScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  Padding="20">
                        <StackPanel x:Name="historyList">
                            <!-- History items would go here if needed -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Video Controls (kept for compatibility) -->
                    <Border x:Name="videoControls"
                            Grid.Row="2" 
                            Background="#F5F8FA" 
                            Padding="20,15"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <!-- Video control buttons would go here -->
                        </StackPanel>
                    </Border>

                    <!-- Report Controls -->
                    <Border x:Name="reportControls"
                            Grid.Row="2" 
                            Background="#F5F8FA" 
                            Padding="20,15"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="💾 Export Report" 
                                    Click="ExportReportClick"
                                    Background="#0D3640"
                                    Foreground="White"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#165666"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="🖨️ Print Report" 
                                    Click="PrintReportClick"
                                    Background="White"
                                    Foreground="#0D3640"
                                    BorderBrush="#C7D8DD"
                                    BorderThickness="1"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F8FA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E1E8ED" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="📊 Generate Report" 
                            Click="GenerateReportClick"
                            Background="#0D3640"
                            Foreground="White"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Padding="25,12"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#165666"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>