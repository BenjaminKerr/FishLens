<Page x:Class="FishLens_App.History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="History"
      Background="{DynamicResource PageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                Background="{DynamicResource PrimaryColorBrush}" 
                Padding="30,25">
            <StackPanel>
                <TextBlock Text="Reports &amp; Analytics" 
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Filter, analyze, and export your detection data" 
                           FontSize="{DynamicResource BaseFontSize}"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontWeight="Normal"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="30,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Filters" 
                                   FontSize="{DynamicResource LargeFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryColorBrush}"
                                   Margin="0,0,0,15"/>

                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Date Range" 
                                       FontSize="{DynamicResource BaseFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryTextBrush}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>

                            <Button Content="Select Entire Date Range" 
                                    Click="AllDatesClick"
                                    Background="{DynamicResource SecondaryBackgroundBrush}"
                                    Foreground="{DynamicResource PrimaryColorBrush}"
                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="10,6"
                                    BorderThickness="1"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="startDatePicker"
                                        Grid.Column="0"
                                        Background="{DynamicResource PageBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        Padding="10,8"
                                        FontSize="{DynamicResource BaseFontSize}"/>

                            <TextBlock Grid.Column="1" 
                                       Text="—" 
                                       VerticalAlignment="Center" 
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryTextBrush}"/>

                            <DatePicker x:Name="endDatePicker"
                                        Grid.Column="2"
                                        Background="{DynamicResource PageBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        Padding="10,8"
                                        FontSize="{DynamicResource BaseFontSize}"/>
                        </Grid>

                        <TextBlock Text="Species" 
                                   FontSize="13" 
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="speciesFilter"
                                  Background="{DynamicResource PageBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Species"/>
                            <ComboBoxItem Content="Trout"/>
                            <ComboBoxItem Content="Salmon"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox>

                        <TextBlock Text="Direction" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="directionFilter"
                                  Background="{DynamicResource PageBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Directions"/>
                            <ComboBoxItem Content="Upstream"/>
                            <ComboBoxItem Content="Downstream"/>
                        </ComboBox>

                        <TextBlock Text="Location" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="cameraFilter"
                                  Background="{DynamicResource PageBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,20"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Locations"/>
                            <ComboBoxItem Content="Keno Dam"/>
                            <ComboBoxItem Content="Link River Dam"/>
                            <ComboBoxItem Content="Spencer Creek"/>
                        </ComboBox>

                        <!-- Group By removed per user request -->

                        <TextBlock Text="Minimum Confidence" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="confidenceSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"/>

                            <TextBlock x:Name="confidenceValueText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="{DynamicResource BaseFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryColorBrush}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Filter detections below this confidence level" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   Margin="0,0,0,20"/>

                        <Button Content="Apply Filters" 
                                Click="ApplyFiltersClick"
                                Background="{DynamicResource PrimaryColorBrush}"
                                Foreground="{DynamicResource SecondaryTextBrush}"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                BorderThickness="0"
                                Cursor="Hand"
                                Margin="0,0,0,10">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <Button Content="Clear Filters" 
                                Click="ClearFiltersClick"
                                Background="{DynamicResource SecondaryBackgroundBrush}"
                                Foreground="{DynamicResource PrimaryColorBrush}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                Cursor="Hand"
                                Margin="0,0,0,25">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="1" 
                    Margin="30,20,30,30" 
                    Background="{DynamicResource SecondaryBackgroundBrush}" 
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" 
                            Background="{DynamicResource PageBackgroundBrush}" 
                            Padding="20,15"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock x:Name="viewTitle"
                                       Text="Analysis Report" 
                                       FontSize="{DynamicResource LargeFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryColorBrush}"
                                       VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Right">
                                <ComboBox x:Name="reportTypeCombo"
                                          FontSize="{DynamicResource BaseFontSize}"
                                          Padding="10,5"
                                          Background="{DynamicResource SecondaryBackgroundBrush}"
                                          BorderBrush="{DynamicResource BorderColorBrush}"
                                          SelectedIndex="0"
                                          SelectionChanged="ReportType_SelectionChanged">
                                    <ComboBoxItem Content="Standard Report"/>
                                    <ComboBoxItem Content="Detailed Analysis"/>
                                    <ComboBoxItem Content="Summary Only"/>
                                    <ComboBoxItem Content="Data Table View"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel x:Name="placeholderPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Text="📊" 
                                   FontSize="{DynamicResource LargeTitleFontSize}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.3"
                                   Foreground="{DynamicResource SecondaryTextBrush}"/>
                        <TextBlock Text="Generate a report" 
                                   FontSize="{DynamicResource LargeFontSize}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Configure your filters and click the button below" 
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <MediaElement x:Name="videoPlayer"
                                  Grid.Row="1"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Margin="20"
                                  Visibility="Collapsed"/>

                    <ScrollViewer x:Name="reportScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  Padding="30,20">
                        <StackPanel x:Name="reportPanel">
                        </StackPanel>
                    </ScrollViewer>

                    <Border x:Name="reportControls"
                            Grid.Row="2" 
                            Background="{DynamicResource PageBackgroundBrush}" 
                            Padding="20,15"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button Content="Export Report" 
                                    Click="ExportReportClick"
                                    Background="{DynamicResource PrimaryColorBrush}"
                                    Foreground="{DynamicResource SecondaryTextBrush}"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                            <Button Content="Print Report" 
                                    Click="PrintReportClick"
                                    Background="{DynamicResource SecondaryBackgroundBrush}"
                                    Foreground="{DynamicResource PrimaryColorBrush}"
                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                    BorderThickness="1"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="20,10"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" 
                Background="{DynamicResource SecondaryBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderColorBrush}" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <Grid>
                <StackPanel Orientation="Horizontal" 
                            HorizontalAlignment="Right">
                    <Button Content="Generate Report" 
                            Click="GenerateReportClick"
                            Background="{DynamicResource PrimaryColorBrush}"
                            Foreground="{DynamicResource SecondaryTextBrush}"
                            FontSize="{DynamicResource BaseFontSize}"
                            FontWeight="SemiBold"
                            Padding="25,12"
                            BorderThickness="0"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}"
                                                    CornerRadius="6"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>