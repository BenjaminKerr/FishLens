<Page x:Class="FishLens_App.History"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="History"
      Background="{DynamicResource PageBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ═══════════════════════════════════════════════════════════
             Header — PrimaryColorBrush (teal) background in both themes.
             Subtitle switched from PrimaryTextBrush (#0D3640 in light —
             invisible on teal) to WhiteBrush with reduced opacity.
        ════════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                Background="{DynamicResource PrimaryColorBrush}"
                Padding="30,25">
            <StackPanel>
                <TextBlock Text="Reports &amp; Analytics"
                           FontSize="{DynamicResource LargeHeaderFontSize}"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource WhiteBrush}"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Filter, analyze, and export your detection data"
                           FontSize="{DynamicResource BaseFontSize}"
                           Foreground="{DynamicResource WhiteBrush}"
                           Opacity="0.75"
                           FontWeight="Normal"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ═══════════════════════════════════════════════════════
                 Filter sidebar
            ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="30,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- "Filters" heading — PrimaryText reads in both themes -->
                        <TextBlock Text="Filters"
                                   FontSize="{DynamicResource LargeFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,15"/>

                        <!-- ── Date Range ── -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Date Range"
                                       FontSize="{DynamicResource BaseFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>

                            <!-- Ghost button: CardBackground + PrimaryText so it sits
                                 quietly on the sidebar in both themes. Hover shifts to
                                 BorderColorBrush (same treatment as Clear Filters). -->
                            <Button Content="Select Entire Date Range"
                                    Click="AllDatesClick"
                                    Background="{DynamicResource CardBackground}"
                                    Foreground="{DynamicResource PrimaryText}"
                                    BorderBrush="{DynamicResource BorderColorBrush}"
                                    BorderThickness="1"
                                    FontSize="{DynamicResource BaseFontSize}"
                                    FontWeight="SemiBold"
                                    Padding="10,6"
                                    Cursor="Hand"
                                    HorizontalAlignment="Right">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource BorderColorBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>

                        <Grid Margin="0,0,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <DatePicker x:Name="startDatePicker"
                                        Grid.Column="0"
                                        Background="{DynamicResource PageBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        Padding="10,8"
                                        FontSize="{DynamicResource BaseFontSize}"/>

                            <TextBlock Grid.Column="1"
                                       Text="—"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       Foreground="{DynamicResource SecondaryText}"/>

                            <DatePicker x:Name="endDatePicker"
                                        Grid.Column="2"
                                        Background="{DynamicResource PageBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderColorBrush}"
                                        Padding="10,8"
                                        FontSize="{DynamicResource BaseFontSize}"/>
                        </Grid>

                        <!-- ── Species ── -->
                        <TextBlock Text="Species"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="speciesFilter"
                                  Background="{DynamicResource PageBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Species"/>
                        </ComboBox>

                        <!-- ── Direction ── -->
                        <TextBlock Text="Direction"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="directionFilter"
                                  Background="{DynamicResource PageBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,15"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Directions"/>
                            <ComboBoxItem Content="Upstream"/>
                            <ComboBoxItem Content="Downstream"/>
                        </ComboBox>

                        <!-- ── Location ── -->
                        <TextBlock Text="Location"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <ComboBox x:Name="cameraFilter"
                                  Background="{DynamicResource PageBackgroundBrush}"
                                  BorderBrush="{DynamicResource BorderColorBrush}"
                                  Padding="12,8"
                                  FontSize="{DynamicResource BaseFontSize}"
                                  Margin="0,0,0,20"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="All Locations"/>
                            <ComboBoxItem Content="Keno Dam"/>
                            <ComboBoxItem Content="Link River Dam"/>
                            <ComboBoxItem Content="Spencer Creek"/>
                        </ComboBox>

                        <!-- ── Confidence slider ── -->
                        <TextBlock Text="Minimum Confidence"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryText}"
                                   Margin="0,0,0,8"/>

                        <Grid Margin="0,0,0,5">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Slider x:Name="confidenceSlider"
                                    Grid.Column="0"
                                    Minimum="0"
                                    Maximum="100"
                                    Value="0"
                                    TickFrequency="10"
                                    IsSnapToTickEnabled="True"
                                    ValueChanged="ConfidenceSlider_ValueChanged"/>

                            <!-- AccentBrush teal is readable in both themes here -->
                            <TextBlock x:Name="confidenceValueText"
                                       Grid.Column="1"
                                       Text="0%"
                                       FontSize="{DynamicResource BaseFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <TextBlock Text="Filter detections below this confidence level"
                                   TextWrapping="Wrap"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   Margin="0,0,0,20"/>

                        <!-- ── Apply Filters — filled accent button ── -->
                        <Button Content="Apply Filters"
                                Click="ApplyFiltersClick"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="{DynamicResource OnAccentForeground}"
                                BorderBrush="{DynamicResource AccentBrush}"
                                BorderThickness="1"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                Cursor="Hand"
                                Margin="0,0,0,8">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource HoverBackgroundBrush}"/>
                                            <Setter Property="BorderBrush" Value="{DynamicResource HoverBackgroundBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                        <!-- ── Clear Filters — ghost button ── -->
                        <Button Content="Clear Filters"
                                Click="ClearFiltersClick"
                                Background="{DynamicResource CardBackground}"
                                Foreground="{DynamicResource PrimaryText}"
                                BorderBrush="{DynamicResource BorderColorBrush}"
                                BorderThickness="1"
                                FontSize="{DynamicResource BaseFontSize}"
                                FontWeight="SemiBold"
                                Padding="0,10"
                                Cursor="Hand"
                                Margin="0,0,0,25">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BorderColorBrush}"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- ═══════════════════════════════════════════════════════
                 Report card (right column)
                 Card header: switched from PageBackgroundBrush to
                 SecondaryBackgroundBrush so it doesn't punch a dark hole
                 in the card on the dark theme.
                 viewTitle: switched from PrimaryColorBrush to PrimaryText
                 so it reads in both themes.
            ════════════════════════════════════════════════════════════ -->
            <Border Grid.Column="1"
                    Margin="30,20,30,30"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource BorderColorBrush}"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Card top bar — matches card so there's no inset contrast clash -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SecondaryBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderColorBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="20,15"
                            CornerRadius="12,12,0,0">
                        <Grid>
                            <TextBlock x:Name="viewTitle"
                                       Text="Analysis Report"
                                       FontSize="{DynamicResource LargeFontSize}"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource PrimaryText}"
                                       VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <!-- Placeholder — emoji Foreground has no effect on glyphs, so
                         opacity sits on the TextBlock itself, not a Foreground color -->
                    <StackPanel x:Name="placeholderPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <TextBlock Text="📊"
                                   FontSize="{DynamicResource LargeTitleFontSize}"
                                   HorizontalAlignment="Center"
                                   Opacity="0.3"/>
                        <TextBlock Text="Generate a report"
                                   FontSize="{DynamicResource LargeFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Configure your filters and click the button below"
                                   FontSize="{DynamicResource BaseFontSize}"
                                   Foreground="{DynamicResource SecondaryText}"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <MediaElement x:Name="videoPlayer"
                                  Grid.Row="1"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Margin="20"
                                  Visibility="Collapsed"/>

                    <ScrollViewer x:Name="reportScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  Padding="30,20">
                        <StackPanel x:Name="reportPanel"/>
                    </ScrollViewer>

                </Grid>
            </Border>

        </Grid>
    </Grid>
</Page>
