<Page x:Class="FishLens_App.History"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="History"
        Background="#F5F8FA">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" 
                Background="#0D3640" 
                Padding="30,25">
            <StackPanel>
                <TextBlock Text="Analysis History" 
                           FontSize="32" 
                           FontWeight="SemiBold"
                           Foreground="White"
                           Margin="0,0,0,5"/>
                <TextBlock Text="Review and edit your fish detection records" 
                           FontSize="14" 
                           Foreground="#B0C4CB"
                           FontWeight="Normal"/>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- History Content -->
            <ScrollViewer Grid.Column="0" 
                          VerticalScrollBarVisibility="Auto"
                          Padding="30,20,30,30">
                <StackPanel x:Name="historyList" 
                            MaxWidth="900" 
                            HorizontalAlignment="Stretch">
                    <!-- History items will be added programmatically -->
                </StackPanel>
            </ScrollViewer>

            <!-- Video Player / Report Section -->
            <Border Grid.Column="1" 
                    Margin="0,20,30,30" 
                    Background="White" 
                    CornerRadius="12"
                    BorderThickness="1"
                    BorderBrush="#C7D8DD"
                    Width="450"
                    VerticalAlignment="Stretch">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0" 
                            Background="#F5F8FA" 
                            Padding="20,15"
                            CornerRadius="12,12,0,0">
                        <TextBlock x:Name="viewTitle"
                                   Text="Video Preview" 
                                   FontSize="16" 
                                   FontWeight="SemiBold"
                                   Foreground="#0D3640"/>
                    </Border>

                    <!-- Placeholder when no video/report selected -->
                    <StackPanel x:Name="placeholderPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center" 
                                VerticalAlignment="Center">
                        <TextBlock Text="🎬" 
                                   FontSize="80" 
                                   HorizontalAlignment="Center"
                                   Opacity="0.3"/>
                        <TextBlock Text="Select a video to play" 
                                   FontSize="16" 
                                   Foreground="#8BA5AE"
                                   HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="or generate a report" 
                                   FontSize="14" 
                                   Foreground="#8BA5AE"
                                   HorizontalAlignment="Center"
                                   Margin="0,5,0,0"/>
                    </StackPanel>

                    <!-- Video Player -->
                    <MediaElement x:Name="videoPlayer"
                                  Grid.Row="1"
                                  LoadedBehavior="Manual"
                                  Stretch="Uniform"
                                  Margin="20"
                                  Visibility="Collapsed"/>

                    <!-- Report View -->
                    <ScrollViewer x:Name="reportScrollViewer"
                                  Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed"
                                  Padding="20">
                        <StackPanel x:Name="reportPanel">
                            <!-- Report content will be added dynamically -->
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Video Controls -->
                    <Border x:Name="videoControls"
                            Grid.Row="2" 
                            Background="#F5F8FA" 
                            Padding="20,15"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <Button x:Name="playButton"
                                    Content="▶ Play" 
                                    Click="PlayButton_Click"
                                    Background="#0D3640"
                                    Foreground="White"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="15,8"
                                    BorderThickness="0"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#165666"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="pauseButton"
                                    Content="⏸ Pause" 
                                    Click="PauseButton_Click"
                                    Background="White"
                                    Foreground="#0D3640"
                                    BorderBrush="#C7D8DD"
                                    BorderThickness="1"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="15,8"
                                    Cursor="Hand"
                                    Margin="0,0,10,0">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F8FA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <Button x:Name="stopButton"
                                    Content="⏹ Stop" 
                                    Click="StopButton_Click"
                                    Background="White"
                                    Foreground="#0D3640"
                                    BorderBrush="#C7D8DD"
                                    BorderThickness="1"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Padding="15,8"
                                    Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}"
                                                            BorderBrush="{TemplateBinding BorderBrush}"
                                                            BorderThickness="{TemplateBinding BorderThickness}"
                                                            CornerRadius="6"
                                                            Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                          VerticalAlignment="Center"/>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#F5F8FA"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Report Controls -->
                    <Border x:Name="reportControls"
                            Grid.Row="2" 
                            Background="#F5F8FA" 
                            Padding="20,15"
                            CornerRadius="0,0,12,12"
                            Visibility="Collapsed">
                        <Button Content="💾 Export Report" 
                                Click="ExportReportClick"
                                Background="#0D3640"
                                Foreground="White"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Padding="15,8"
                                BorderThickness="0"
                                Cursor="Hand"
                                HorizontalAlignment="Center">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}"
                                                        CornerRadius="6"
                                                        Padding="{TemplateBinding Padding}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                    <Style.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#165666"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- Footer Buttons -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E1E8ED" 
                BorderThickness="0,1,0,0"
                Padding="30,20">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Right">
                <Button Content="📊 Generate Report" 
                        Click="GenerateReportClick"
                        Background="White"
                        Foreground="#0D3640"
                        BorderBrush="#0D3640"
                        BorderThickness="2"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="20,10"
                        Cursor="Hand"
                        Margin="0,0,15,0">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#F5F8FA"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <Button Content="💾 Save Changes" 
                        Click="SaveButtonClick"
                        Background="#0D3640"
                        Foreground="White"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Padding="20,10"
                        BorderThickness="0"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                                CornerRadius="6"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#165666"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Page>